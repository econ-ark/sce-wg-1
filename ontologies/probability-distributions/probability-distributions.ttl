    skos:definition "The one law all of whose mass is at one; the parameter files' only way to switch a shock off."@en ;
    pd:subfamilyOf pd:PD_0000020 ;
    pd:hasConstraint pd:PD_0000012 ;
    pd:hasChart pd:PD_0000025 .

pd:PD_0000025
    a owl:NamedIndividual, pd:Chart ;
    rdfs:label "no coordinates"@en ;
    skos:notation "point-mass-at-one/degenerate" ;
    pd:chartOf pd:PD_0000024 ;
    pd:toCanonical [ pd:name "x" ; pd:formula "1" ] ;
    pd:conversion "exact" ;
    pd:writtenAs [ pd:format "parameter-file" ; pd:spelling "{Degenerate: {}}" ; pd:head "Degenerate" ] ;
    pd:writtenAs [ pd:format "bellman-sym" ; pd:spelling "LogNormal(0, 0)" ; pd:head "LogNormal" ; pd:argument [ pd:position 1 ; pd:formula "0" ] ; pd:argument [ pd:position 2 ; pd:formula "0" ] ] .

pd:PD_0000026
    a owl:NamedIndividual, pd:Operator ;
    rdfs:label "truncation to an interval"@en ;
    skos:notation "interval-conditioning" ;
    skos:definition "Conditioning on the interval [l, u], which must have positive measure."@en ;
    pd:caseOf pd:PD_0000003 ;
    pd:argument [ pd:position 1 ; pd:name "lower" ; pd:meaning "the lower bound l; -inf for none"@en ] ;
    pd:argument [ pd:position 2 ; pd:name "upper" ; pd:meaning "the upper bound u; inf for none"@en ] ;
    pd:set "lower <= z <= upper" .

pd:PD_0000027
    a owl:NamedIndividual, pd:Family ;
    rdfs:label "truncated normal"@en ;
    skos:notation "truncated-normal" ;
    skos:definition "The law of μ + σZ given l ≤ μ + σZ ≤ u, Z standard normal."@en ;
    pd:statedSet "[l, u] ∩ ℝ" ;
    pd:measureExpression "TruncatedNormal(μ, σ, l, u) = (aff(μ, σ)∗ N(0, 1))|[l, u]" ;
    pd:builtFrom [ pd:base pd:PD_0000001 ; pd:step [ pd:position 1 ; pd:operator pd:PD_0000005 ; pd:argument [ pd:position 1 ; pd:name "location" ; pd:formula "mu" ] ; pd:argument [ pd:position 2 ; pd:name "scale" ; pd:formula "sigma" ] ] ; pd:step [ pd:position 2 ; pd:operator pd:PD_0000026 ; pd:argument [ pd:position 1 ; pd:name "lower" ; pd:formula "l" ] ; pd:argument [ pd:position 2 ; pd:name "upper" ; pd:formula "u" ] ] ] ;
    pd:auxiliary [ pd:position 1 ; pd:name "a" ; pd:formula "(l - mu)/sigma" ] ;
    pd:auxiliary [ pd:position 2 ; pd:name "b" ; pd:formula "(u - mu)/sigma" ] ;
    pd:auxiliary [ pd:position 3 ; pd:name "D" ; pd:formula "Phi(b) - Phi(a)" ] ;
    pd:canonicalChart pd:PD_0000028 ;
    pd:hasChart pd:PD_0000028 ;
    pd:hasPropertyValue [ pd:property pd:PD_0000007 ; pd:infimum "l" ; pd:supremum "u" ; pd:massAtInfimum "0" ] ;
    pd:hasPropertyValue [ pd:property pd:PD_0000008 ; pd:formula "mu + sigma*(phi(a) - phi(b))/D" ] ;
    pd:hasPropertyValue [ pd:property pd:PD_0000009 ; pd:orders "nonnegative-integers" ] ;
    pd:reduction [ pd:when "l == -inf and u == inf" ; pd:reductionChart pd:PD_0000014 ] .

pd:PD_0000028
    a owl:NamedIndividual, pd:Chart ;
    rdfs:label "the normal's mean and standard deviation, and the bounds"@en ;
    skos:notation "truncated-normal/mean-sd-bounds" ;
    pd:chartOf pd:PD_0000027 ;
    pd:coordinate [ pd:position 1 ; pd:name "mu" ; pd:symbol "μ" ; pd:meaning "the mean of the normal before truncation"@en ; pd:domain "real" ] ;
    pd:coordinate [ pd:position 2 ; pd:name "sigma" ; pd:symbol "σ" ; pd:meaning "the standard deviation of the normal before truncation"@en ; pd:domain "positive" ] ;
    pd:coordinate [ pd:position 3 ; pd:name "l" ; pd:symbol "l" ; pd:meaning "the lower bound; -inf for none"@en ; pd:domain "extended-real" ] ;
    pd:coordinate [ pd:position 4 ; pd:name "u" ; pd:symbol "u" ; pd:meaning "the upper bound; inf for none"@en ; pd:domain "extended-real" ] ;
    pd:domainCondition "l < u" ;
    pd:writtenAs [ pd:format "bellman-sym" ; pd:spelling "TruncatedNormal(μ, σ, l, u)" ; pd:head "TruncatedNormal" ; pd:argument [ pd:position 1 ; pd:formula "mu" ] ; pd:argument [ pd:position 2 ; pd:formula "sigma" ] ; pd:argument [ pd:position 3 ; pd:formula "l" ] ; pd:argument [ pd:position 4 ; pd:formula "u" ] ] ;
    skos:closeMatch <http://www.probonto.org/ontology#PROB_k0000681> .

pd:PD_0000029
    a owl:NamedIndividual, pd:Family ;
    rdfs:label "truncated lognormal"@en ;
    skos:notation "truncated-lognormal" ;
    skos:definition "The law of exp(μ + σZ) given l ≤ exp(μ + σZ) ≤ u, Z standard normal: the exponential of a normal truncated to [ln l, ln u]."@en ;
    pd:statedSet "[l, u] ∩ (0, ∞)" ;
    pd:measureExpression "TruncatedLogNormal(μ, σ, l, u) = (exp∗ aff(μ, σ)∗ N(0, 1))|[l, u] = exp∗ ((aff(μ, σ)∗ N(0, 1))|[ln l, ln u])" ;
    pd:builtFrom [ pd:base pd:PD_0000001 ; pd:step [ pd:position 1 ; pd:operator pd:PD_0000005 ; pd:argument [ pd:position 1 ; pd:name "location" ; pd:formula "mu" ] ; pd:argument [ pd:position 2 ; pd:name "scale" ; pd:formula "sigma" ] ] ; pd:step [ pd:position 2 ; pd:operator pd:PD_0000006 ] ; pd:step [ pd:position 3 ; pd:operator pd:PD_0000026 ; pd:argument [ pd:position 1 ; pd:name "lower" ; pd:formula "l" ] ; pd:argument [ pd:position 2 ; pd:name "upper" ; pd:formula "u" ] ] ] ;
    pd:auxiliary [ pd:position 1 ; pd:name "a" ; pd:formula "(log(l) - mu)/sigma" ] ;
    pd:auxiliary [ pd:position 2 ; pd:name "b" ; pd:formula "(log(u) - mu)/sigma" ] ;
    pd:auxiliary [ pd:position 3 ; pd:name "D" ; pd:formula "Phi(b) - Phi(a)" ] ;
    pd:canonicalChart pd:PD_0000030 ;
    pd:hasChart pd:PD_0000030 ;
    pd:hasPropertyValue [ pd:property pd:PD_0000007 ; pd:infimum "l" ; pd:supremum "u" ; pd:massAtInfimum "0" ] ;
    pd:hasPropertyValue [ pd:property pd:PD_0000008 ; pd:formula "exp(mu + sigma**2/2)*(Phi(b - sigma) - Phi(a - sigma))/D" ] ;
    pd:hasPropertyValue [ pd:property pd:PD_0000009 ; pd:orders "all-real" ; pd:formula "exp(k*mu + k**2*sigma**2/2)*(Phi(b - k*sigma) - Phi(a - k*sigma))/D" ] ;
    pd:hasPropertyValue [ pd:property pd:PD_0000010 ; pd:orders "nonnegative-integers" ] ;
    pd:reduction [ pd:when "l == 0 and u == inf" ; pd:reductionChart pd:PD_0000017 ] .

pd:PD_0000030
    a owl:NamedIndividual, pd:Chart ;
    rdfs:label "the mean and standard deviation of the logarithm before truncation, and the bounds"@en ;
    skos:notation "truncated-lognormal/meanlog-sdlog-bounds" ;
    pd:chartOf pd:PD_0000029 ;
    pd:coordinate [ pd:position 1 ; pd:name "mu" ; pd:symbol "μ" ; pd:meaning "the mean of ln X before truncation"@en ; pd:domain "real" ] ;
    pd:coordinate [ pd:position 2 ; pd:name "sigma" ; pd:symbol "σ" ; pd:meaning "the standard deviation of ln X before truncation"@en ; pd:domain "positive" ] ;
    pd:coordinate [ pd:position 3 ; pd:name "l" ; pd:symbol "l" ; pd:meaning "the lower bound, in the draw's units; 0 for none"@en ; pd:domain "extended-nonnegative" ] ;
    pd:coordinate [ pd:position 4 ; pd:name "u" ; pd:symbol "u" ; pd:meaning "the upper bound, in the draw's units; inf for none"@en ; pd:domain "extended-nonnegative" ] ;
    pd:domainCondition "l < u" ;
    pd:writtenAs [ pd:format "bellman-sym" ; pd:spelling "TruncatedLogNormal(μ, σ, l, u)" ; pd:head "TruncatedLogNormal" ; pd:argument [ pd:position 1 ; pd:formula "mu" ] ; pd:argument [ pd:position 2 ; pd:formula "sigma" ] ; pd:argument [ pd:position 3 ; pd:formula "l" ] ; pd:argument [ pd:position 4 ; pd:formula "u" ] ] .

pd:PD_0000031
    a owl:NamedIndividual, pd:Family ;
    rdfs:label "truncated lognormal with mean one"@en ;
    skos:notation "mean-one-truncated-lognormal" ;
    skos:definition "The truncated lognormal laws whose mean is one. Their chart is the parameter files' TruncatedLogNormal: the standard deviation of the logarithm after truncation, and the bounds in standard deviations of the normal before truncation."@en ;
    pd:subfamilyOf pd:PD_0000029 ;
    pd:hasConstraint pd:PD_0000012 ;
    pd:hasChart pd:PD_0000032 .

pd:PD_0000032
    a owl:NamedIndividual, pd:Chart ;
    rdfs:label "the standard deviation of the logarithm after truncation, and the bounds in standard deviations"@en ;
    skos:notation "mean-one-truncated-lognormal/sd-log-standardized-bounds" ;
    pd:chartOf pd:PD_0000031 ;
    pd:coordinate [ pd:position 1 ; pd:name "sd_log" ; pd:symbol "σ" ; pd:meaning "the standard deviation of ln X, after truncation"@en ; pd:domain "positive" ; pd:asExpectation "sqrt(E(log(X)**2) - E(log(X))**2)" ] ;
    pd:coordinate [ pd:position 2 ; pd:name "bot" ; pd:symbol "bot" ; pd:meaning "the lower bound, in standard deviations of the normal before truncation; -inf for none"@en ; pd:domain "extended-real" ] ;
    pd:coordinate [ pd:position 3 ; pd:name "top" ; pd:symbol "top" ; pd:meaning "the upper bound, in standard deviations of the normal before truncation; inf for none"@en ; pd:domain "extended-real" ] ;
    pd:domainCondition "bot < top" ;
    pd:domainCondition "bot > -inf or top < inf" ;
    pd:toCanonicalAuxiliary [ pd:position 1 ; pd:name "D" ; pd:formula "Phi(top) - Phi(bot)" ] ;
    pd:toCanonicalAuxiliary [ pd:position 2 ; pd:name "v" ; pd:formula "1 + (xphi(bot) - xphi(top))/D - ((phi(bot) - phi(top))/D)**2" ] ;
    pd:toCanonicalAuxiliary [ pd:position 3 ; pd:name "s" ; pd:formula "sd_log/sqrt(v)" ] ;
    pd:toCanonicalAuxiliary [ pd:position 4 ; pd:name "m" ; pd:formula "-s**2/2 - log((Phi(top - s) - Phi(bot - s))/D)" ] ;
    pd:fromCanonicalAuxiliary [ pd:position 1 ; pd:name "a" ; pd:formula "(log(l) - mu)/sigma" ] ;
    pd:fromCanonicalAuxiliary [ pd:position 2 ; pd:name "b" ; pd:formula "(log(u) - mu)/sigma" ] ;
    pd:fromCanonicalAuxiliary [ pd:position 3 ; pd:name "D" ; pd:formula "Phi(b) - Phi(a)" ] ;
    pd:fromCanonicalAuxiliary [ pd:position 4 ; pd:name "v" ; pd:formula "1 + (xphi(a) - xphi(b))/D - ((phi(a) - phi(b))/D)**2" ] ;
    pd:toCanonical [ pd:name "mu" ; pd:formula "m" ] ;
    pd:toCanonical [ pd:name "sigma" ; pd:formula "s" ] ;
    pd:toCanonical [ pd:name "l" ; pd:formula "exp(m + s*bot)" ] ;
    pd:toCanonical [ pd:name "u" ; pd:formula "exp(m + s*top)" ] ;
    pd:fromCanonical [ pd:name "sd_log" ; pd:formula "sigma*sqrt(v)" ] ;
    pd:fromCanonical [ pd:name "bot" ; pd:formula "a" ] ;
    pd:fromCanonical [ pd:name "top" ; pd:formula "b" ] ;
    pd:conversion "irrational" ;
    pd:writtenAs [ pd:format "parameter-file" ; pd:spelling "{TruncatedLogNormal: {sd_log: σ, bot: bot, top: top}}" ; pd:head "TruncatedLogNormal" ; pd:argument [ pd:position 1 ; pd:name "sd_log" ; pd:formula "sd_log" ] ; pd:argument [ pd:position 2 ; pd:name "bot" ; pd:formula "bot" ] ; pd:argument [ pd:position 3 ; pd:name "top" ; pd:formula "top" ] ; pd:default "bot = -3" ; pd:default "top = 3" ; pd:noneToken "null" ; pd:noneValue "bot = -inf" ; pd:noneValue "top = inf" ] .

pd:PD_0000033
    a owl:NamedIndividual, pd:Measure ;
    rdfs:label "uniform on the unit interval"@en ;
    skos:notation "unit-uniform" ;
    skos:definition "Lebesgue measure on [0, 1]."@en ;
    pd:statedSet "[0, 1]" ;
    pd:notation "U(0, 1)" ;
    pd:density "1" ;
    pd:support [ pd:infimum "0" ; pd:supremum "1" ] .

pd:PD_0000034
    a owl:NamedIndividual, pd:Family ;
    rdfs:label "uniform"@en ;
    skos:notation "uniform" ;
    skos:definition "The law with constant density on [a, b]."@en ;
    pd:statedSet "[a, b]" ;
    pd:measureExpression "Uniform(a, b) = aff(a, b − a)∗ U(0, 1)" ;
    pd:builtFrom [ pd:base pd:PD_0000033 ; pd:step [ pd:position 1 ; pd:operator pd:PD_0000005 ; pd:argument [ pd:position 1 ; pd:name "location" ; pd:formula "a" ] ; pd:argument [ pd:position 2 ; pd:name "scale" ; pd:formula "b - a" ] ] ] ;
    pd:canonicalChart pd:PD_0000035 ;
    pd:hasChart pd:PD_0000035 ;
    pd:hasPropertyValue [ pd:property pd:PD_0000007 ; pd:infimum "a" ; pd:supremum "b" ; pd:massAtInfimum "0" ] ;
    pd:hasPropertyValue [ pd:property pd:PD_0000008 ; pd:formula "(a + b)/2" ] ;
    pd:hasPropertyValue [ pd:property pd:PD_0000009 ; pd:orders "nonnegative-integers" ; pd:formula "(b**(k + 1) - a**(k + 1))/((k + 1)*(b - a))" ] .

pd:PD_0000035
    a owl:NamedIndividual, pd:Chart ;
    rdfs:label "the endpoints"@en ;
    skos:notation "uniform/endpoints" ;
    pd:chartOf pd:PD_0000034 ;
    pd:coordinate [ pd:position 1 ; pd:name "a" ; pd:symbol "a" ; pd:meaning "the lower endpoint"@en ; pd:domain "real" ] ;
    pd:coordinate [ pd:position 2 ; pd:name "b" ; pd:symbol "b" ; pd:meaning "the upper endpoint"@en ; pd:domain "real" ] ;
    pd:domainCondition "a < b" ;
    pd:writtenAs [ pd:format "bellman-sym" ; pd:spelling "Uniform(a, b)" ; pd:head "Uniform" ; pd:argument [ pd:position 1 ; pd:formula "a" ] ; pd:argument [ pd:position 2 ; pd:formula "b" ] ] ;
    skos:exactMatch <http://www.probonto.org/ontology#PROB_k0000703> .

pd:PD_0000036
    a owl:NamedIndividual, pd:Family ;
    rdfs:label "uniform with mean one"@en ;
    skos:notation "mean-one-uniform" ;
    skos:definition "The uniform laws centered at one. Their chart is the parameter files' Uniform, whose half-width below one keeps every value positive."@en ;
    pd:subfamilyOf pd:PD_0000034 ;
    pd:hasConstraint pd:PD_0000012 ;
    pd:hasChart pd:PD_0000037 .

pd:PD_0000037
    a owl:NamedIndividual, pd:Chart ;
    rdfs:label "the half-width"@en ;
    skos:notation "mean-one-uniform/half-width" ;
    pd:chartOf pd:PD_0000036 ;
    pd:coordinate [ pd:position 1 ; pd:name "w" ; pd:symbol "w" ; pd:meaning "the half-width"@en ; pd:domain "positive" ; pd:asExpectation "sqrt(3*(E(X**2) - E(X)**2))" ] ;
    pd:domainCondition "w < 1" ;
    pd:toCanonical [ pd:name "a" ; pd:formula "1 - w" ] ;
    pd:toCanonical [ pd:name "b" ; pd:formula "1 + w" ] ;
    pd:fromCanonical [ pd:name "w" ; pd:formula "(b - a)/2" ] ;
    pd:conversion "exact" ;
    pd:writtenAs [ pd:format "parameter-file" ; pd:spelling "{Uniform: {half_width: w}}" ; pd:head "Uniform" ; pd:argument [ pd:position 1 ; pd:name "half_width" ; pd:formula "w" ] ] ;
    pd:writtenAs [ pd:format "bellman-sym" ; pd:spelling "Uniform(1 - w, 1 + w)" ; pd:head "Uniform" ; pd:argument [ pd:position 1 ; pd:formula "1 - w" ] ; pd:argument [ pd:position 2 ; pd:formula "1 + w" ] ] .

pd:PD_0000038
    a owl:NamedIndividual, pd:Measure ;
    rdfs:label "standard Gumbel"@en ;
    skos:notation "standard-gumbel" ;
    skos:definition "The measure on ℝ with distribution function exp(−exp(−z)), and so density exp(−z − exp(−z))."@en ;
    pd:statedSet "ℝ" ;
    pd:notation "Gumbel(0, 1)" ;
    pd:density "exp(-(z + exp(-z)))" ;
    pd:support [ pd:infimum "-inf" ; pd:supremum "inf" ] .

pd:PD_0000039
    a owl:NamedIndividual, pd:Family ;
    rdfs:label "type I extreme value (Gumbel)"@en ;
    skos:notation "type-1-extreme-value" ;
    skos:definition "The law of μ + sG, G standard Gumbel, with distribution function exp(−exp(−(x − μ)/s)): the taste shock of logit choice."@en ;
    pd:statedSet "ℝ" ;
    pd:measureExpression "TypeIExtremeValue(μ, s) = aff(μ, s)∗ Gumbel(0, 1)" ;
    pd:builtFrom [ pd:base pd:PD_0000038 ; pd:step [ pd:position 1 ; pd:operator pd:PD_0000005 ; pd:argument [ pd:position 1 ; pd:name "location" ; pd:formula "mu" ] ; pd:argument [ pd:position 2 ; pd:name "scale" ; pd:formula "s" ] ] ] ;
    pd:canonicalChart pd:PD_0000040 ;
    pd:hasChart pd:PD_0000040 ;
    pd:hasPropertyValue [ pd:property pd:PD_0000007 ; pd:infimum "-inf" ; pd:supremum "inf" ; pd:massAtInfimum "0" ] ;
    pd:hasPropertyValue [ pd:property pd:PD_0000008 ; pd:formula "mu + euler_gamma*s" ] ;
    pd:hasPropertyValue [ pd:property pd:PD_0000009 ; pd:orders "nonnegative-integers" ] .

pd:PD_0000040
    a owl:NamedIndividual, pd:Chart ;
    rdfs:label "location and scale"@en ;
    skos:notation "type-1-extreme-value/location-scale" ;
    pd:chartOf pd:PD_0000039 ;
    pd:coordinate [ pd:position 1 ; pd:name "mu" ; pd:symbol "μ" ; pd:meaning "the location, which is the mode"@en ; pd:domain "real" ; pd:asExpectation "E(X) - euler_gamma*sqrt(6*(E(X**2) - E(X)**2))/pi" ] ;
    pd:coordinate [ pd:position 2 ; pd:name "s" ; pd:symbol "s" ; pd:meaning "the scale"@en ; pd:domain "positive" ; pd:asExpectation "sqrt(6*(E(X**2) - E(X)**2))/pi" ] ;
    pd:writtenAs [ pd:format "bellman-sym" ; pd:spelling "TypeIExtremeValue(μ, s)" ; pd:head "TypeIExtremeValue" ; pd:argument [ pd:position 1 ; pd:formula "mu" ] ; pd:argument [ pd:position 2 ; pd:formula "s" ] ] ;
    skos:exactMatch <http://www.probonto.org/ontology#PROB_k0000032> .

pd:PD_0000041
    a owl:NamedIndividual, pd:Operator ;
    rdfs:label "finite mixture"@en ;
    skos:notation "finite-mixture" ;
    skos:definition "Σⱼ wⱼ μⱼ: draw a label j with probability wⱼ, then a value from μⱼ. It is the product of the categorical law on the labels with the kernel sending j to μⱼ, projected onto the value."@en ;
    pd:caseOf pd:PD_0000004 ;
    pd:argument [ pd:position 1 ; pd:name "weights" ; pd:meaning "a probability vector w"@en ] ;
    pd:argument [ pd:position 2 ; pd:name "components" ; pd:meaning "the laws μ₁, …, μₙ"@en ] ;
    pd:writtenAs [ pd:format "bellman-sym" ; pd:spelling "Mixture((w₁, J₁), …, (wₙ, Jₙ))" ; pd:head "Mixture" ] .

pd:PD_0000042
    a owl:NamedIndividual, pd:Family ;
    rdfs:label "finite discrete law on real points"@en ;
    skos:notation "finite-discrete" ;
    skos:definition "The law putting mass pᵢ at each of finitely many real points vᵢ, at least two."@en ;
    pd:statedSet "{v₁, …, vₙ}" ;
    pd:measureExpression "Σᵢ pᵢ δ(vᵢ), a finite mixture of point masses" ;
    pd:canonicalChart pd:PD_0000043 ;
    pd:hasChart pd:PD_0000043 ;
    pd:hasPropertyValue [ pd:property pd:PD_0000007 ; pd:infimum "first(values)" ; pd:supremum "last(values)" ; pd:massAtInfimum "first(probs)" ] ;
    pd:hasPropertyValue [ pd:property pd:PD_0000008 ; pd:formula "sum(probs*values)" ] ;
    pd:hasPropertyValue [ pd:property pd:PD_0000009 ; pd:orders "nonnegative-integers" ; pd:formula "sum(probs*values**k)" ] ;
    pd:hasPropertyValue [ pd:property pd:PD_0000011 ; pd:value [ pd:atomAt "values" ; pd:atomMass "probs" ] ] .

pd:PD_0000043
    a owl:NamedIndividual, pd:Chart ;
    rdfs:label "the points and their probabilities"@en ;
    skos:notation "finite-discrete/values-probabilities" ;
    pd:chartOf pd:PD_0000042 ;
    pd:coordinate [ pd:position 1 ; pd:name "values" ; pd:symbol "v" ; pd:meaning "the points, strictly increasing"@en ; pd:domain "real-vector" ] ;
    pd:coordinate [ pd:position 2 ; pd:name "probs" ; pd:symbol "p" ; pd:meaning "their probabilities"@en ; pd:domain "positive-probability-vector" ] ;
    pd:domainCondition "count(values) == count(probs)" ;
    pd:domainCondition "count(values) >= 2" ;
    pd:domainCondition "increasing(values)" ;
    pd:writtenAs [ pd:format "bellman-sym" ; pd:spelling "Mixture((p₁, v₁), …, (pₙ, vₙ))" ; pd:head "Mixture" ] .

pd:PD_0000044
    a owl:NamedIndividual, pd:Family ;
    rdfs:label "finite discrete law with mean one"@en ;
    skos:notation "mean-one-finite-discrete" ;
    skos:definition "The finite discrete laws on positive points whose mean is one. Their chart is the parameter files' Discrete: the points are the model, not a quadrature of another law."@en ;
    pd:subfamilyOf pd:PD_0000042 ;
    pd:hasConstraint pd:PD_0000012 ;
    pd:hasChart pd:PD_0000045 .

pd:PD_0000045
    a owl:NamedIndividual, pd:Chart ;
    rdfs:label "the points and their probabilities"@en ;
    skos:notation "mean-one-finite-discrete/values-probabilities" ;
    pd:chartOf pd:PD_0000044 ;
    pd:coordinate [ pd:position 1 ; pd:name "values" ; pd:symbol "v" ; pd:meaning "the points, positive and strictly increasing"@en ; pd:domain "positive-vector" ] ;
    pd:coordinate [ pd:position 2 ; pd:name "probs" ; pd:symbol "p" ; pd:meaning "their probabilities"@en ; pd:domain "positive-probability-vector" ] ;
    pd:domainCondition "count(values) == count(probs)" ;
    pd:domainCondition "count(values) >= 2" ;
    pd:domainCondition "increasing(values)" ;
    pd:domainCondition "sum(probs*values) == 1" ;
    pd:toCanonical [ pd:name "values" ; pd:formula "values" ] ;
    pd:toCanonical [ pd:name "probs" ; pd:formula "probs" ] ;
    pd:fromCanonical [ pd:name "values" ; pd:formula "values" ] ;
    pd:fromCanonical [ pd:name "probs" ; pd:formula "probs" ] ;
    pd:conversion "exact" ;
    pd:writtenAs [ pd:format "parameter-file" ; pd:spelling "{Discrete: {values: [v₁, …, vₙ], probs: [p₁, …, pₙ]}}" ; pd:head "Discrete" ; pd:argument [ pd:position 1 ; pd:name "values" ; pd:formula "values" ] ; pd:argument [ pd:position 2 ; pd:name "probs" ; pd:formula "probs" ] ] .

pd:PD_0000046
    a owl:NamedIndividual, pd:Family ;
    rdfs:label "categorical"@en ;
    skos:notation "categorical" ;
    skos:definition "The law drawing the label in position i of a finite set with probability fᵢ. Bellman-SYM also takes its weights as the rows of a matrix, or as the one row a previous state selects; the latter is the categorical law at that row."@en ;
    pd:statedSet "the positions 1, …, n of a finite set of labels" ;
    pd:measureExpression "Σᵢ fᵢ δ(i)" ;
    pd:canonicalChart pd:PD_0000047 ;
    pd:hasChart pd:PD_0000047 ;
    pd:hasChart pd:PD_0000048 ;
    pd:hasPropertyValue [ pd:property pd:PD_0000011 ; pd:value [ pd:atomAt "index(f)" ; pd:atomMass "f" ] ] .

pd:PD_0000047
    a owl:NamedIndividual, pd:Chart ;
    rdfs:label "the weights, in the order of the labels"@en ;
    skos:notation "categorical/weights" ;
    pd:chartOf pd:PD_0000046 ;
    pd:coordinate [ pd:position 1 ; pd:name "f" ; pd:symbol "f" ; pd:meaning "the probability of each label"@en ; pd:domain "probability-vector" ] ;
    pd:writtenAs [ pd:format "bellman-sym" ; pd:spelling "Categorical((f₁, …, fₙ))" ; pd:head "Categorical" ; pd:argument [ pd:position 1 ; pd:formula "f" ] ] ;
    skos:closeMatch <http://www.probonto.org/ontology#PROB_k0000248> .

pd:PD_0000048
    a owl:NamedIndividual, pd:Chart ;
    rdfs:label "the probability of the second of two labels"@en ;
    skos:notation "categorical/bernoulli" ;
    pd:chartOf pd:PD_0000046 ;
    pd:coordinate [ pd:position 1 ; pd:name "p" ; pd:symbol "p" ; pd:meaning "the probability of the second label"@en ; pd:domain "unit-interval" ] ;
    pd:covers "count(f) == 2" ;
    pd:toCanonical [ pd:name "f" ; pd:formula "[1 - p, p]" ] ;
    pd:fromCanonical [ pd:name "p" ; pd:formula "last(f)" ] ;
    pd:conversion "exact" ;
    pd:writtenAs [ pd:format "bellman-sym" ; pd:spelling "Bernoulli(p)" ; pd:head "Bernoulli" ; pd:argument [ pd:position 1 ; pd:formula "p" ] ] ;
    skos:closeMatch <http://www.probonto.org/ontology#PROB_k0000000> .

pd:PD_0000049
    a owl:NamedIndividual, pd:Family ;
    rdfs:label "finite Markov kernel"@en ;
    skos:notation "finite-markov-kernel" ;
    skos:definition "A Markov kernel on finitely many real points: from the point in position i, the next draw is xⱼ with probability Πᵢⱼ. Bellman-SYM writes it with either of two names; given a third argument, the previous state, a declaration is the kernel at that state."@en ;
    pd:statedSet "{x₁, …, xₙ}, the points" ;
    pd:measureExpression "κ(i, ·) = Σⱼ Πᵢⱼ δ(xⱼ)" ;
    pd:state [ pd:name "i" ; pd:symbol "i" ; pd:meaning "the position of the current point"@en ; pd:range "count(points)" ] ;
    pd:canonicalChart pd:PD_0000050 ;
    pd:hasChart pd:PD_0000050 ;
    pd:hasPropertyValue [ pd:property pd:PD_0000008 ; pd:formula "sum(row(Pi, i)*points)" ] ;
    pd:hasPropertyValue [ pd:property pd:PD_0000009 ; pd:orders "nonnegative-integers" ; pd:formula "sum(row(Pi, i)*points**k)" ] ;
    pd:hasPropertyValue [ pd:property pd:PD_0000011 ; pd:value [ pd:atomAt "points" ; pd:atomMass "row(Pi, i)" ] ] .

pd:PD_0000050
    a owl:NamedIndividual, pd:Chart ;
    rdfs:label "the transition matrix and the points"@en ;
    skos:notation "finite-markov-kernel/transitions-points" ;
    pd:chartOf pd:PD_0000049 ;
    pd:coordinate [ pd:position 1 ; pd:name "Pi" ; pd:symbol "Π" ; pd:meaning "the transition probabilities, row i the law from point i"@en ; pd:domain "stochastic-matrix" ] ;
    pd:coordinate [ pd:position 2 ; pd:name "points" ; pd:symbol "x" ; pd:meaning "the points, strictly increasing"@en ; pd:domain "real-vector" ] ;
    pd:domainCondition "count(Pi) == count(points)" ;
    pd:domainCondition "increasing(points)" ;
    pd:writtenAs [ pd:format "bellman-sym" ; pd:spelling "DiscreteMarkov(Π, points)" ; pd:head "DiscreteMarkov" ; pd:argument [ pd:position 1 ; pd:formula "Pi" ] ; pd:argument [ pd:position 2 ; pd:formula "points" ] ] ;
    pd:writtenAs [ pd:format "bellman-sym" ; pd:spelling "MarkovChain(Π, points)" ; pd:head "MarkovChain" ; pd:argument [ pd:position 1 ; pd:formula "Pi" ] ; pd:argument [ pd:position 2 ; pd:formula "points" ] ] .

pd:PD_0000051
    a owl:NamedIndividual, pd:Family ;
    rdfs:label "lognormal mixture"@en ;
    skos:notation "lognormal-mixture" ;
    skos:definition "A finite mixture of lognormal laws, at least two. Its components are compared as a set: the same components in another order, or a component split in two, write the same law."@en ;
    pd:statedSet "(0, ∞)" ;
    pd:measureExpression "Σⱼ wⱼ LogNormal(μⱼ, σⱼ), the mixture over the components of exp∗ aff(μⱼ, σⱼ)∗ N(0, 1)" ;
    pd:builtFrom [ pd:mixtureWeights "weights" ; pd:base pd:PD_0000001 ; pd:step [ pd:position 1 ; pd:operator pd:PD_0000005 ; pd:argument [ pd:position 1 ; pd:name "location" ; pd:formula "mu[j]" ] ; pd:argument [ pd:position 2 ; pd:name "scale" ; pd:formula "sigma[j]" ] ] ; pd:step [ pd:position 2 ; pd:operator pd:PD_0000006 ] ] ;
    pd:canonicalChart pd:PD_0000052 ;
    pd:hasChart pd:PD_0000052 ;
    pd:hasPropertyValue [ pd:property pd:PD_0000007 ; pd:infimum "0" ; pd:supremum "inf" ; pd:massAtInfimum "0" ] ;
    pd:hasPropertyValue [ pd:property pd:PD_0000008 ; pd:formula "sum(weights*exp(mu + sigma**2/2))" ] ;
    pd:hasPropertyValue [ pd:property pd:PD_0000009 ; pd:orders "all-real" ; pd:formula "sum(weights*exp(k*mu + k**2*sigma**2/2))" ] .

pd:PD_0000052
    a owl:NamedIndividual, pd:Chart ;
    rdfs:label "the weights, and each component's mean and standard deviation of the logarithm"@en ;
    skos:notation "lognormal-mixture/components" ;
    pd:chartOf pd:PD_0000051 ;
    pd:coordinate [ pd:position 1 ; pd:name "weights" ; pd:symbol "w" ; pd:meaning "the components' weights"@en ; pd:domain "positive-probability-vector" ] ;
    pd:coordinate [ pd:position 2 ; pd:name "mu" ; pd:symbol "μ" ; pd:meaning "each component's mean of ln X"@en ; pd:domain "real-vector" ] ;
    pd:coordinate [ pd:position 3 ; pd:name "sigma" ; pd:symbol "σ" ; pd:meaning "each component's standard deviation of ln X"@en ; pd:domain "positive-vector" ] ;
    pd:domainCondition "count(weights) == count(mu) and count(weights) == count(sigma)" ;
    pd:domainCondition "count(weights) >= 2" ;
    pd:writtenAs [ pd:format "bellman-sym" ; pd:spelling "Mixture((w₁, LogNormal(μ₁, σ₁)), …, (wₙ, LogNormal(μₙ, σₙ)))" ; pd:head "Mixture" ] .

pd:PD_0000053
    a owl:NamedIndividual, pd:Family ;
    rdfs:label "lognormal mixture with mean one"@en ;
    skos:notation "mean-one-lognormal-mixture" ;
    skos:definition "The lognormal mixtures whose mean is one. Their chart is the parameter files' LogNormalMixture: ln X = c + Y, Y drawn from component j with probability wⱼ, each component's mean of Y stated relative to the others, and one common shift c making the mean one."@en ;
    pd:subfamilyOf pd:PD_0000051 ;
    pd:hasConstraint pd:PD_0000012 ;
    pd:hasChart pd:PD_0000054 .

pd:PD_0000054
    a owl:NamedIndividual, pd:Chart ;
    rdfs:label "the weights, each component's relative mean and standard deviation of the logarithm"@en ;
    skos:notation "mean-one-lognormal-mixture/relative-means" ;
    pd:chartOf pd:PD_0000053 ;
    pd:coordinate [ pd:position 1 ; pd:name "weights" ; pd:symbol "w" ; pd:meaning "the components' weights"@en ; pd:domain "positive-probability-vector" ] ;
    pd:coordinate [ pd:position 2 ; pd:name "mean_log" ; pd:symbol "m" ; pd:meaning "each component's mean of ln X less the common shift"@en ; pd:domain "real-vector" ] ;
    pd:coordinate [ pd:position 3 ; pd:name "sd_log" ; pd:symbol "s" ; pd:meaning "each component's standard deviation of ln X"@en ; pd:domain "positive-vector" ; pd:asComponentExpectation "sqrt(E(log(X)**2) - E(log(X))**2)" ] ;
    pd:domainCondition "count(weights) == count(mean_log) and count(weights) == count(sd_log)" ;
    pd:domainCondition "count(weights) >= 2" ;
    pd:domainCondition "sum(weights*mean_log) == 0" ;
    pd:domainCondition "lex_increasing(mean_log, sd_log)" ;
    pd:toCanonicalAuxiliary [ pd:position 1 ; pd:name "c" ; pd:formula "-log(sum(weights*exp(mean_log + sd_log**2/2)))" ] ;
    pd:fromCanonicalAuxiliary [ pd:position 1 ; pd:name "c" ; pd:formula "sum(weights*mu)" ] ;
    pd:toCanonical [ pd:name "weights" ; pd:formula "weights" ] ;
    pd:toCanonical [ pd:name "mu" ; pd:formula "c + mean_log" ] ;
    pd:toCanonical [ pd:name "sigma" ; pd:formula "sd_log" ] ;
    pd:fromCanonical [ pd:name "weights" ; pd:formula "weights" ] ;
    pd:fromCanonical [ pd:name "mean_log" ; pd:formula "mu - c" ] ;
    pd:fromCanonical [ pd:name "sd_log" ; pd:formula "sigma" ] ;
    pd:conversion "irrational" ;
    pd:writtenAs [ pd:format "parameter-file" ; pd:spelling "{LogNormalMixture: {components: [{weight: w₁, mean_log: m₁, sd_log: s₁}, …]}}" ; pd:head "LogNormalMixture" ; pd:argument [ pd:position 1 ; pd:name "weight" ; pd:formula "weights" ] ; pd:argument [ pd:position 2 ; pd:name "mean_log" ; pd:formula "mean_log" ] ; pd:argument [ pd:position 3 ; pd:name "sd_log" ; pd:formula "sd_log" ] ; pd:perComponent true ] ;
    pd:writtenAs [ pd:format "bellman-sym" ; pd:spelling "Mixture((w₁, LogNormal(c + m₁, s₁)), …), with c making the mean one" ; pd:head "Mixture" ] .

pd:PD_0000055
    a owl:NamedIndividual, pd:Family ;
    rdfs:label "truncated lognormal mixture"@en ;
    skos:notation "truncated-lognormal-mixture" ;
    skos:definition "A finite mixture of truncated lognormal laws, at least two. Its components are compared as a set; a component truncated on neither side is a lognormal."@en ;
    pd:statedSet "(0, ∞)" ;
    pd:measureExpression "Σⱼ wⱼ TruncatedLogNormal(μⱼ, σⱼ, lⱼ, uⱼ)" ;
    pd:builtFrom [ pd:mixtureWeights "weights" ; pd:base pd:PD_0000001 ; pd:step [ pd:position 1 ; pd:operator pd:PD_0000005 ; pd:argument [ pd:position 1 ; pd:name "location" ; pd:formula "mu[j]" ] ; pd:argument [ pd:position 2 ; pd:name "scale" ; pd:formula "sigma[j]" ] ] ; pd:step [ pd:position 2 ; pd:operator pd:PD_0000006 ] ; pd:step [ pd:position 3 ; pd:operator pd:PD_0000026 ; pd:argument [ pd:position 1 ; pd:name "lower" ; pd:formula "l[j]" ] ; pd:argument [ pd:position 2 ; pd:name "upper" ; pd:formula "u[j]" ] ] ] ;
    pd:auxiliary [ pd:position 1 ; pd:name "a" ; pd:formula "(log(l) - mu)/sigma" ] ;
    pd:auxiliary [ pd:position 2 ; pd:name "b" ; pd:formula "(log(u) - mu)/sigma" ] ;
    pd:auxiliary [ pd:position 3 ; pd:name "D" ; pd:formula "Phi(b) - Phi(a)" ] ;
    pd:canonicalChart pd:PD_0000056 ;
    pd:hasChart pd:PD_0000056 ;
    pd:hasPropertyValue [ pd:property pd:PD_0000007 ; pd:infimum "min(l)" ; pd:supremum "max(u)" ; pd:massAtInfimum "0" ] ;
    pd:hasPropertyValue [ pd:property pd:PD_0000008 ; pd:formula "sum(weights*exp(mu + sigma**2/2)*(Phi(b - sigma) - Phi(a - sigma))/D)" ] ;
    pd:hasPropertyValue [ pd:property pd:PD_0000009 ; pd:orders "all-real" ; pd:formula "sum(weights*exp(k*mu + k**2*sigma**2/2)*(Phi(b - k*sigma) - Phi(a - k*sigma))/D)" ] ;
    pd:reduction [ pd:when "all(l == 0) and all(u == inf)" ; pd:reductionChart pd:PD_0000052 ] .

pd:PD_0000056
    a owl:NamedIndividual, pd:Chart ;
    rdfs:label "the weights, and each component's canonical truncated-lognormal coordinates"@en ;
    skos:notation "truncated-lognormal-mixture/components" ;
    pd:chartOf pd:PD_0000055 ;
    pd:coordinate [ pd:position 1 ; pd:name "weights" ; pd:symbol "w" ; pd:meaning "the components' weights"@en ; pd:domain "positive-probability-vector" ] ;
    pd:coordinate [ pd:position 2 ; pd:name "mu" ; pd:symbol "μ" ; pd:meaning "each component's mean of ln X before truncation"@en ; pd:domain "real-vector" ] ;
    pd:coordinate [ pd:position 3 ; pd:name "sigma" ; pd:symbol "σ" ; pd:meaning "each component's standard deviation of ln X before truncation"@en ; pd:domain "positive-vector" ] ;
    pd:coordinate [ pd:position 4 ; pd:name "l" ; pd:symbol "l" ; pd:meaning "each component's lower bound, in the draw's units"@en ; pd:domain "extended-nonnegative-vector" ] ;
    pd:coordinate [ pd:position 5 ; pd:name "u" ; pd:symbol "u" ; pd:meaning "each component's upper bound, in the draw's units"@en ; pd:domain "extended-nonnegative-vector" ] ;
    pd:domainCondition "count(weights) == count(mu) and count(weights) == count(sigma)" ;
    pd:domainCondition "count(weights) == count(l) and count(weights) == count(u)" ;
    pd:domainCondition "count(weights) >= 2" ;
    pd:domainCondition "l < u" ;
    pd:writtenAs [ pd:format "bellman-sym" ; pd:spelling "Mixture((w₁, TruncatedLogNormal(μ₁, σ₁, l₁, u₁)), …)" ; pd:head "Mixture" ] .

pd:PD_0000057
    a owl:NamedIndividual, pd:Family ;
    rdfs:label "truncated lognormal mixture with mean one"@en ;
    skos:notation "mean-one-truncated-lognormal-mixture" ;
    skos:definition "The truncated lognormal mixtures whose mean is one. Their chart is the parameter files' TruncatedLogNormalMixture: ln X = c + Y, Y drawn from component j with probability wⱼ, component j a normal truncated at bounds in standard deviations of that normal before truncation, stated by its mean, relative to the others, and its standard deviation, both after truncation, with one common shift c making the mean one."@en ;
    pd:subfamilyOf pd:PD_0000055 ;
    pd:hasConstraint pd:PD_0000012 ;
    pd:hasChart pd:PD_0000058 .

pd:PD_0000058
    a owl:NamedIndividual, pd:Chart ;
    rdfs:label "the weights, each component's relative mean and standard deviation of the logarithm after truncation, and its bounds"@en ;
    skos:notation "mean-one-truncated-lognormal-mixture/relative-means-standardized-bounds" ;
    pd:chartOf pd:PD_0000057 ;
    pd:coordinate [ pd:position 1 ; pd:name "weights" ; pd:symbol "w" ; pd:meaning "the components' weights"@en ; pd:domain "positive-probability-vector" ] ;
    pd:coordinate [ pd:position 2 ; pd:name "mean_log" ; pd:symbol "m" ; pd:meaning "each component's mean of ln X after truncation, less the common shift"@en ; pd:domain "real-vector" ] ;
    pd:coordinate [ pd:position 3 ; pd:name "sd_log" ; pd:symbol "s" ; pd:meaning "each component's standard deviation of ln X after truncation"@en ; pd:domain "positive-vector" ; pd:asComponentExpectation "sqrt(E(log(X)**2) - E(log(X))**2)" ] ;
    pd:coordinate [ pd:position 4 ; pd:name "bot" ; pd:symbol "bot" ; pd:meaning "each component's lower bound, in standard deviations of its normal before truncation; -inf for none"@en ; pd:domain "extended-real-vector" ] ;
    pd:coordinate [ pd:position 5 ; pd:name "top" ; pd:symbol "top" ; pd:meaning "each component's upper bound, in standard deviations of its normal before truncation; inf for none"@en ; pd:domain "extended-real-vector" ] ;
    pd:domainCondition "count(weights) == count(mean_log) and count(weights) == count(sd_log)" ;
    pd:domainCondition "count(weights) == count(bot) and count(weights) == count(top)" ;
    pd:domainCondition "count(weights) >= 2" ;
    pd:domainCondition "bot < top" ;
    pd:domainCondition "any(bot > -inf) or any(top < inf)" ;
    pd:domainCondition "sum(weights*mean_log) == 0" ;
    pd:domainCondition "lex_increasing(mean_log, sd_log, bot, top)" ;
    pd:toCanonicalAuxiliary [ pd:position 1 ; pd:name "D" ; pd:formula "Phi(top) - Phi(bot)" ] ;
    pd:toCanonicalAuxiliary [ pd:position 2 ; pd:name "lam" ; pd:formula "(phi(bot) - phi(top))/D" ] ;
    pd:toCanonicalAuxiliary [ pd:position 3 ; pd:name "v" ; pd:formula "1 + (xphi(bot) - xphi(top))/D - lam**2" ] ;
    pd:toCanonicalAuxiliary [ pd:position 4 ; pd:name "s" ; pd:formula "sd_log/sqrt(v)" ] ;
    pd:toCanonicalAuxiliary [ pd:position 5 ; pd:name "loc" ; pd:formula "mean_log - s*lam" ] ;
    pd:toCanonicalAuxiliary [ pd:position 6 ; pd:name "c" ; pd:formula "-log(sum(weights*exp(loc + s**2/2)*(Phi(top - s) - Phi(bot - s))/D))" ] ;
    pd:fromCanonicalAuxiliary [ pd:position 1 ; pd:name "a" ; pd:formula "(log(l) - mu)/sigma" ] ;
    pd:fromCanonicalAuxiliary [ pd:position 2 ; pd:name "b" ; pd:formula "(log(u) - mu)/sigma" ] ;
    pd:fromCanonicalAuxiliary [ pd:position 3 ; pd:name "D" ; pd:formula "Phi(b) - Phi(a)" ] ;
    pd:fromCanonicalAuxiliary [ pd:position 4 ; pd:name "lam" ; pd:formula "(phi(a) - phi(b))/D" ] ;
    pd:fromCanonicalAuxiliary [ pd:position 5 ; pd:name "v" ; pd:formula "1 + (xphi(a) - xphi(b))/D - lam**2" ] ;
    pd:fromCanonicalAuxiliary [ pd:position 6 ; pd:name "ml" ; pd:formula "mu + sigma*lam" ] ;
    pd:fromCanonicalAuxiliary [ pd:position 7 ; pd:name "c" ; pd:formula "sum(weights*ml)" ] ;
    pd:toCanonical [ pd:name "weights" ; pd:formula "weights" ] ;
    pd:toCanonical [ pd:name "mu" ; pd:formula "c + loc" ] ;
    pd:toCanonical [ pd:name "sigma" ; pd:formula "s" ] ;
    pd:toCanonical [ pd:name "l" ; pd:formula "exp(c + loc + s*bot)" ] ;
    pd:toCanonical [ pd:name "u" ; pd:formula "exp(c + loc + s*top)" ] ;
    pd:fromCanonical [ pd:name "weights" ; pd:formula "weights" ] ;
    pd:fromCanonical [ pd:name "mean_log" ; pd:formula "ml - c" ] ;
    pd:fromCanonical [ pd:name "sd_log" ; pd:formula "sigma*sqrt(v)" ] ;
    pd:fromCanonical [ pd:name "bot" ; pd:formula "a" ] ;
    pd:fromCanonical [ pd:name "top" ; pd:formula "b" ] ;
    pd:conversion "irrational" ;
    pd:writtenAs [ pd:format "parameter-file" ; pd:spelling "{TruncatedLogNormalMixture: {components: [{weight: w₁, mean_log: m₁, sd_log: s₁, bot: b₁, top: t₁}, …]}}" ; pd:head "TruncatedLogNormalMixture" ; pd:argument [ pd:position 1 ; pd:name "weight" ; pd:formula "weights" ] ; pd:argument [ pd:position 2 ; pd:name "mean_log" ; pd:formula "mean_log" ] ; pd:argument [ pd:position 3 ; pd:name "sd_log" ; pd:formula "sd_log" ] ; pd:argument [ pd:position 4 ; pd:name "bot" ; pd:formula "bot" ] ; pd:argument [ pd:position 5 ; pd:name "top" ; pd:formula "top" ] ; pd:default "bot = -3" ; pd:default "top = 3" ; pd:perComponent true ; pd:noneToken "null" ; pd:noneValue "bot = -inf" ; pd:noneValue "top = inf" ] ;
    pd:writtenAs [ pd:format "bellman-sym" ; pd:spelling "Mixture((w₁, TruncatedLogNormal(μ₁, σ₁, l₁, u₁)), …), computed from the chart" ; pd:head "Mixture" ] .

pd:PD_0000059
    a owl:NamedIndividual, pd:Operator ;
    rdfs:label "piecewise-linear map"@en ;
    skos:notation "piecewise-linear-pushforward" ;
    skos:definition "The pushforward under the nondecreasing piecewise-linear function through the knots; an abscissa listed twice is a jump."@en ;
    pd:caseOf pd:PD_0000002 ;
    pd:argument [ pd:position 1 ; pd:name "knots_u" ; pd:meaning "the knots' abscissae, nondecreasing"@en ] ;
    pd:argument [ pd:position 2 ; pd:name "knots_q" ; pd:meaning "the knots' ordinates, nondecreasing"@en ] ;
    pd:map "interp(z, knots_u, knots_q)" .

pd:PD_0000060
    a owl:NamedIndividual, pd:Family ;
    rdfs:label "quantile table"@en ;
    skos:notation "quantile-table" ;
    skos:definition "The law whose quantile function Q, the inverse of the distribution function, is linear between the points of a table: Q∗ U(0, 1). A stretch where u and Q both rise has a flat density; one where u rises and Q stays flat is a point mass; a u listed twice, with Q higher the second time, is a gap in the support. The normal form removes an interior point that lies on the line through its neighbors, which adds nothing; the canonical chart admits none."@en ;
    pd:statedSet "[Q(0), Q(1)]" ;
    pd:measureExpression "Q∗ U(0, 1), Q piecewise linear through the points (uᵢ, qᵢ)" ;
    pd:builtFrom [ pd:base pd:PD_0000033 ; pd:step [ pd:position 1 ; pd:operator pd:PD_0000059 ; pd:argument [ pd:position 1 ; pd:name "knots_u" ; pd:formula "u" ] ; pd:argument [ pd:position 2 ; pd:name "knots_q" ; pd:formula "q" ] ] ] ;
    pd:canonicalChart pd:PD_0000061 ;
    pd:hasChart pd:PD_0000061 ;
    pd:hasPropertyValue [ pd:property pd:PD_0000007 ; pd:infimum "first(q)" ; pd:supremum "last(q)" ; pd:massAtInfimum "first(diff(u))*(first(diff(q)) == 0)" ] ;
    pd:hasPropertyValue [ pd:property pd:PD_0000008 ; pd:formula "sum(diff(u)*(heads(q) + tails(q))/2)" ] .

pd:PD_0000061
    a owl:NamedIndividual, pd:Chart ;
    rdfs:label "the points of the table"@en ;
    skos:notation "quantile-table/points" ;
    pd:chartOf pd:PD_0000060 ;
    pd:coordinate [ pd:position 1 ; pd:name "u" ; pd:symbol "u" ; pd:meaning "the probabilities, from 0 to 1"@en ; pd:domain "unit-interval-vector" ] ;
    pd:coordinate [ pd:position 2 ; pd:name "q" ; pd:symbol "Q" ; pd:meaning "the quantiles there"@en ; pd:domain "real-vector" ] ;
    pd:domainCondition "count(u) == count(q) and count(u) >= 3" ;
    pd:domainCondition "first(u) == 0 and last(u) == 1 and first(diff(u)) > 0 and last(diff(u)) > 0" ;
    pd:domainCondition "diff(u) >= 0 and diff(q) >= 0" ;
    pd:domainCondition "heads(diff(u)) + tails(diff(u)) > 0" ;
    pd:domainCondition "diff(u) > 0 or diff(q) > 0" ;
    pd:domainCondition "any(diff(u)*diff(q) > 0)" ;
    pd:domainCondition "heads(diff(q))*tails(diff(u)) != tails(diff(q))*heads(diff(u))" .

pd:PD_0000062
    a owl:NamedIndividual, pd:Family ;
    rdfs:label "quantile table with mean one"@en ;
    skos:notation "mean-one-quantile-table" ;
    skos:definition "The quantile tables on positive values whose mean is one. Their chart is the parameter files' Tabulated, whose checker accepts a mean within 10⁻¹² of one; the table is the law, not an approximation of one."@en ;
    pd:subfamilyOf pd:PD_0000060 ;
    pd:hasConstraint pd:PD_0000012 ;
    pd:hasChart pd:PD_0000063 .

pd:PD_0000063
    a owl:NamedIndividual, pd:Chart ;
    rdfs:label "the points of the table"@en ;
    skos:notation "mean-one-quantile-table/points" ;
    pd:chartOf pd:PD_0000062 ;
    pd:coordinate [ pd:position 1 ; pd:name "u" ; pd:symbol "u" ; pd:meaning "the probabilities, from 0 to 1"@en ; pd:domain "unit-interval-vector" ] ;
    pd:coordinate [ pd:position 2 ; pd:name "q" ; pd:symbol "Q" ; pd:meaning "the quantiles there, positive"@en ; pd:domain "positive-vector" ] ;
    pd:domainCondition "count(u) == count(q) and count(u) >= 3" ;
    pd:domainCondition "first(u) == 0 and last(u) == 1 and first(diff(u)) > 0 and last(diff(u)) > 0" ;
    pd:domainCondition "diff(u) >= 0 and diff(q) >= 0" ;
    pd:domainCondition "heads(diff(u)) + tails(diff(u)) > 0" ;
    pd:domainCondition "diff(u) > 0 or diff(q) > 0" ;
    pd:domainCondition "any(diff(u)*diff(q) > 0)" ;
    pd:domainCondition "heads(diff(q))*tails(diff(u)) != tails(diff(q))*heads(diff(u))" ;
    pd:domainCondition "sum(diff(u)*(heads(q) + tails(q))/2) == 1" ;
    pd:toCanonical [ pd:name "u" ; pd:formula "u" ] ;
    pd:toCanonical [ pd:name "q" ; pd:formula "q" ] ;
    pd:fromCanonical [ pd:name "u" ; pd:formula "u" ] ;
    pd:fromCanonical [ pd:name "q" ; pd:formula "q" ] ;
    pd:conversion "exact" ;
    pd:writtenAs [ pd:format "parameter-file" ; pd:spelling "{Tabulated: {points: [[u₁, Q₁], …, [uₙ, Qₙ]]}}" ; pd:head "Tabulated" ] .
