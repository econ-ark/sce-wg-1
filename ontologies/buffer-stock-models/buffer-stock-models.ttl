bsm:momentOf a owl:ObjectProperty ;
    skos:definition "The shock whose law a moment is taken under."@en .

bsm:dependsOn a owl:ObjectProperty ;
    skos:definition "A row whose symbol a formula names."@en .

bsm:hasFactor a owl:ObjectProperty ;
    skos:definition "The quantity a condition bounds."@en .

bsm:domain a owl:ObjectProperty ;
    skos:definition "The condition under which a quantity is finite."@en .

bsm:assumes a owl:ObjectProperty ;
    skos:definition "A condition or property a result assumes to hold."@en .

bsm:assumesFailureOf a owl:ObjectProperty ;
    skos:definition "A condition or property a result assumes to fail."@en .

