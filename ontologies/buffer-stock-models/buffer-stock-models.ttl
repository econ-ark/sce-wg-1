    bsm:formatRole "notation" .

bsm:BSM_0000001
    a owl:Class ;
    rdfs:subClassOf bsm:Model ;
    a bsm:ModelClass ;
    rdfs:label "buffer-stock model"@en ;
    skos:notation "buffer-stock-model" ;
    skos:definition "A consumption-saving problem of one agent, with CRRA utility and relative risk aversion above one, assets that earn a return, and risky noncapital income that is permanent income times a transitory shock, permanent income growing by a factor and a mean-one permanent shock; and borrowing in one of the four borrowing-constraint scenarios: the natural constraint in force with a point mass at the joint worst income, or without one, an artificial constraint tighter than the natural one, or zero infima. Whether a member exhibits buffer-stock saving is a property of its solution, not of its membership."@en ;
    bsm:hasAxiom bsm:BSM_0000010 ;
    bsm:hasAxiom bsm:BSM_0000011 ;
    bsm:hasAxiom bsm:BSM_0000012 ;
    bsm:hasAxiom bsm:BSM_0000148 ;
    bsm:hasAxiom bsm:BSM_0000013 ;
    bsm:hasAxiom bsm:BSM_0000014 ;
    bsm:hasAxiom bsm:BSM_0000220 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-intro> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsec-setup> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> .

bsm:BSM_0000002
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000210 ;
    a bsm:ModelClass ;
    rdfs:label "Buffer Stock Theory's model, as the paper states it"@en ;
    skos:notation "bst-model" ;
    skos:definition "The buffer-stock models whose shocks are iid with bounded support, whose transitory shock has a zero-income event of positive probability, with no artificial constraint, infinite lives and one type: the class to which the paper's theorems apply. It lies in the natural scenario with a point mass, the zero-income event."@en ;
    bsm:hasAxiom bsm:BSM_0000016 ;
    bsm:hasAxiom bsm:BSM_0000018 ;
    bsm:hasAxiom bsm:BSM_0000149 ;
    bsm:hasAxiom bsm:BSM_0000019 ;
    bsm:hasAxiom bsm:BSM_0000020 ;
    bsm:hasAxiom bsm:BSM_0000021 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#bounded-support> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-transhkdef> .

bsm:BSM_0000003
    a owl:Class ;
    rdfs:subClassOf bsm:Model ;
    a bsm:ModelClass ;
    rdfs:label "the perfect-foresight benchmark"@en ;
    skos:notation "perfect-foresight-benchmark" ;
    skos:definition "The models with no shocks: ψ = θ = 1 and no unemployment. They fail the axiom of income risk and so are not buffer-stock models; they are the class's limit as the shocks vanish, and the paper's benchmark for the patience conditions."@en ;
    bsm:benchmarkOf bsm:BSM_0000001 ;
    bsm:hasAxiom bsm:BSM_0000022 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-pfincome> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsec-pfbbenchmark> .

bsm:BSM_0000004
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000001 ;
    a bsm:ModelClass ;
    rdfs:label "buffer-stock model with perpetual youth"@en ;
    skos:notation "with-survival" ;
    skos:definition "A buffer-stock model in which an agent survives each period with probability ℒ ≤ 1 and is replaced at death by a newborn; there is no annuity, so survivors earn R and the assets of the dead leave the economy: the paper's Modigliani scheme of estates."@en ;
    bsm:reducesTo bsm:BSM_0000002 ;
    bsm:reductionWhen "L == 1" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-mortality> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#modigliani-lives> .

bsm:BSM_0000005
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000001 ;
    a bsm:ModelClass ;
    rdfs:label "buffer-stock model with Blanchard's annuities"@en ;
    skos:notation "with-blanchard-annuities" ;
    skos:definition "A buffer-stock model with perpetual youth in which the estates of the dead are paid to survivors in proportion to their wealth, so that survivors earn R/ℒ and the absolute patience factor is the same as with infinite lives."@en ;
    bsm:reducesTo bsm:BSM_0000002 ;
    bsm:reductionWhen "L == 1" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-mortality> .

bsm:BSM_0000006
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000001 ;
    a bsm:ModelClass ;
    rdfs:label "buffer-stock model with a positive unemployment benefit"@en ;
    skos:notation "with-positive-benefit" ;
    skos:definition "A buffer-stock model whose unemployment event pays ξ_u > 0 of permanent income in place of BST's zero-income event."@en ;
    bsm:reducesTo bsm:BSM_0000002 ;
    bsm:reductionWhen "xi_u == 0" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> .

bsm:BSM_0000007
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000001 ;
    a bsm:ModelClass ;
    rdfs:label "buffer-stock model with an artificial borrowing constraint"@en ;
    skos:notation "with-artificial-constraint" ;
    skos:definition "A buffer-stock model with an artificial borrowing constraint a_Art strictly above the natural one. A constraint no tighter than the natural one has no effect, and describes the model without it."@en ;
    bsm:hasAxiom bsm:BSM_0000215 ;
    bsm:hasAxiom bsm:BSM_0000216 ;
    bsm:reducesTo bsm:BSM_0000002 ;
    bsm:reductionWhen "a_Art <= a_Nat" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsubsec-deatonislimit> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-liqconstraslimit> .

bsm:BSM_0000008
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000001 ;
    a bsm:ModelClass ;
    rdfs:label "buffer-stock population of permanent types"@en ;
    skos:notation "with-types" ;
    skos:definition "A population of K permanent types with shares ω_i, each a buffer-stock model differing from the others in its discount factor β_i alone. The types are solved separately; the population is their mixture."@en ;
    bsm:reducesTo bsm:BSM_0000002 ;
    bsm:reductionWhen "K == 1" ;
    dcterms:source <https://github.com/llorracc/HAFiscal-QE/blob/1afdf80de4325e436a0c1c20895f754aefefd38c/Subfiles/Parameterization.tex#L48> .

bsm:BSM_0000009
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000001 ;
    a bsm:ModelClass ;
    rdfs:label "buffer-stock model with Markov employment and an aggregate regime"@en ;
    skos:notation "with-markov-states" ;
    skos:definition "A buffer-stock model whose transitory income depends on a Markov employment state, with benefits that expire, and on an aggregate regime that is itself a Markov state; HAFiscal's household. The paper remarks that persistent but mean-reverting transitory shocks would change none of its key results; the conditions become conditions on matrices over the states."@en ;
    bsm:reducesTo bsm:BSM_0000002 ;
    bsm:reductionWhen "the chain has one state" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> ;
    dcterms:source <https://github.com/llorracc/HAFiscal-QE/blob/1afdf80de4325e436a0c1c20895f754aefefd38c/Subfiles/Parameterization.tex#L124> .

bsm:BSM_0000145
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000001 ;
    a bsm:ModelClass ;
    rdfs:label "buffer-stock model with a higher rate on borrowing"@en ;
    skos:notation "with-kinked-return" ;
    skos:definition "A buffer-stock model in which negative assets pay a return factor above the one positive assets earn."@en ;
    bsm:reducesTo bsm:BSM_0000002 ;
    bsm:reductionWhen "R_boro == R" .

bsm:BSM_0000146
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000001 ;
    a bsm:ModelClass ;
    rdfs:label "buffer-stock model with a risky asset"@en ;
    skos:notation "with-risky-asset" ;
    skos:definition "A buffer-stock model in which assets, or a share of them the agent chooses, earn a random return. Such a model is taken to have a target; its conditions are not yet stated, and this ontology states none."@en ;
    bsm:reducesTo bsm:BSM_0000002 ;
    bsm:reductionWhen "the return is riskless" .

bsm:BSM_0000147
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000001 ;
    a bsm:ModelClass ;
    rdfs:label "life-cycle buffer-stock model"@en ;
    skos:notation "life-cycle" ;
    skos:definition "A buffer-stock model with a finite horizon whose primitives may vary with age. A primitive binds the stage occurrence of the period whose block reads it. In the one-stage period the buffer-stock families write, β and ℒ are read in period t's decision block, and R, 𝒢 and the laws of the shocks in period t+1's arrival block: both are the move from t to t+1. The paper's limiting solution is the limit of such problems with constant primitives as the horizon recedes."@en ;
    bsm:reducesTo bsm:BSM_0000002 ;
    bsm:reductionWhen "constant primitives, in the limit of an infinite horizon" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-theory> .

bsm:BSM_0000180
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000003 ;
    a bsm:ModelClass ;
    rdfs:label "the constrained perfect-foresight benchmark"@en ;
    skos:notation "perfect-foresight-constrained" ;
    skos:definition "The perfect-foresight benchmark with the constraint a ≥ 0, so that c ≤ m. With income certain, the natural limit lies below zero, so the constraint is an artificial one. These models are the limit, as the shocks vanish, of the liquidity-constrained class, and the paper's benchmark for that problem."@en ;
    bsm:benchmarkOf bsm:BSM_0000200 ;
    bsm:hasAxiom bsm:BSM_0000181 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#perfect-foresight-with-liquidity-constraints> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsec-pfcon> .

bsm:BSM_0000200
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000001 ;
    a bsm:ModelClass ;
    rdfs:label "the liquidity-constrained model"@en ;
    skos:notation "liquidity-constrained" ;
    skos:definition "A buffer-stock model whose constraint in force is a ≥ 0 and binds: an artificial constraint at zero above a negative natural one (the artificial scenario at a_Art = 0), or zero infima, where both constraints give a ≥ 0 (the zero-infima scenario). It has no zero-income event, which would keep the constraint from binding. With ℘ = 0, a positive lowest income and BST's other primitives, it is the paper's liquidity-constrained problem, the limit of BST's model as ℘ ↓ 0. In normalized form, it is the income fluctuation problem of Ma, Stachurski and Toda (2020)."@en ;
    bsm:hasAxiom bsm:BSM_0000201 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsubsec-deatonislimit> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-liqconstraslimit> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#remark-stochdiscmst> .

bsm:BSM_0000209
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000001 ;
    a bsm:ModelClass ;
    rdfs:label "a buffer-stock model with the natural constraint in force"@en ;
    skos:notation "natural-constraint" ;
    skos:definition "A buffer-stock model with no artificial constraint tighter than the natural one, so that a > −h_min, the natural constraint, is the one in force, and with both shocks' laws bounded, with strictly positive floors and finite ceilings, as BST assumes. Bounded support is a condition of membership here."@en ;
    bsm:hasAxiom bsm:BSM_0000213 ;
    bsm:hasAxiom bsm:BSM_0000017 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#borocnstnat> .

bsm:BSM_0000210
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000209 ;
    a bsm:ModelClass ;
    rdfs:label "the natural scenario with a point mass"@en ;
    skos:notation "natural-with-point-mass" ;
    skos:definition "A model with the natural constraint in force whose joint worst income, the worst transitory income with ψ at its floor, has positive probability. No agent ever ends a period at the natural limit. BST's own model, whose zero-income event is the point mass, is a member, with h_min = 0. The schemas' family bst-natural/1."@en ;
    bsm:hasAxiom bsm:BSM_0000015 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> .

bsm:BSM_0000211
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000209 ;
    a bsm:ModelClass ;
    rdfs:label "the natural scenario without a point mass"@en ;
    skos:notation "natural-without-point-mass" ;
    skos:definition "A model with the natural constraint in force whose joint worst income has probability zero. An agent can end a period at the natural limit only when ϱ < k, with k the number of shocks that have densities at their floors. No family of the schemas writes it: its family, bst-natural-no-point-mass/1, was abolished on 2026-11-03 as an uninteresting case."@en ;
    bsm:hasAxiom bsm:BSM_0000214 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> .

bsm:BSM_0000212
    a owl:Class ;
    rdfs:subClassOf bsm:BSM_0000001 ;
    a bsm:ModelClass ;
    rdfs:label "the zero-infima scenario"@en ;
    skos:notation "zero-infima" ;
    skos:definition "A buffer-stock model whose permanent shock or employed draw has infimum zero, so that the minimum present value of future income is zero and the natural constraint is a ≥ 0, which an artificial constraint at zero would only repeat. With no zero-income event and finite E[θ^(−ϱ)] (and E[ψ^(−ϱ)] where ψ's infimum is zero), the constraint binds. Ma, Stachurski and Toda's lognormal case. No family of the schemas writes it: its family, bst-zero-infima/1, was abolished on 2026-11-03 as an uninteresting case."@en ;
    bsm:hasAxiom bsm:BSM_0000217 ;
    bsm:hasAxiom bsm:BSM_0000218 ;
    bsm:hasAxiom bsm:BSM_0000219 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#remark-stochdiscmst> ;
    dcterms:source <https://arxiv.org/abs/1905.13045v3> .

bsm:BSM_0000010
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "one agent's consumption-saving problem"@en ;
    skos:notation "one-agent-saving" ;
    skos:definition "Each period one agent splits market resources m between consumption c > 0 and end-of-period assets a = m − c, maximizing expected discounted utility; resources next period are R a/(𝒢ψ′) + ξ′ in ratios to permanent income."@en ;
    bsm:tier "membership" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000001 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-levelrecproblem> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-dbcparts> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-veqnnrmrecbellman> .

bsm:BSM_0000011
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "CRRA utility with relative risk aversion above one"@en ;
    skos:notation "crra-above-one" ;
    skos:definition "u(c) = c^(1−ϱ)/(1−ϱ) with ϱ > 1, so that u(0⁺) = −∞."@en ;
    bsm:check "rho > 1" ;
    bsm:tier "membership" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000001 ;
    bsm:dependsOn bsm:BSM_0000037 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsec-setup> .

bsm:BSM_0000012
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "the Friedman–Muth income process"@en ;
    skos:notation "friedman-muth-income" ;
    skos:definition "Noncapital income is 𝐩 ξ, with permanent income 𝐩′ = 𝒢 ψ′ 𝐩; the permanent shock ψ is positive with E[ψ] = 1, and the transitory shock ξ is nonnegative with a finite positive mean."@en ;
    bsm:tier "membership" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000001 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-dbcparts> .

bsm:BSM_0000013
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "assets earn a return"@en ;
    skos:notation "asset-return" ;
    skos:definition "End-of-period assets earn a gross return factor R > 0 into next period. In the paper's model it is riskless and constant; a risky return or a higher rate on borrowing makes an extension."@en ;
    bsm:check "R > 0" ;
    bsm:tier "membership" ;
    bsm:status "proposed" ;
    bsm:axiomOf bsm:BSM_0000001 ;
    bsm:dependsOn bsm:BSM_0000040 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-dbcparts> .

bsm:BSM_0000014
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "the borrowing constraint in force"@en ;
    skos:notation "constraint-in-force" ;
    skos:definition "End-of-period assets satisfy a ≥ a_min = max(a_Art, a_Nat): the natural constraint, which u(0⁺) = −∞ and the worst income impose, or a tighter artificial one."@en ;
    bsm:tier "membership" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000001 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#borocnstnat> .

bsm:BSM_0000015
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "a point mass at the joint worst income"@en ;
    skos:notation "point-mass-at-joint-worst-income" ;
    skos:definition "The joint worst income, the worst transitory income with ψ at its floor, carries positive probability under the true law: p_worst > 0. An earlier draft required the worst transitory realization to be a point mass where the natural constraint is in force; the condition is now the joint one, since with a positive worst transitory income and a continuous ψ a point mass in ξ alone has probability zero jointly, and made the model without one a scenario of its own (natural-without-point-mass). The paper calls such an atom inessential to its proofs."@en ;
    bsm:check "p_worst > 0" ;
    bsm:tier "membership" ;
    bsm:status "ruling" ;
    bsm:ruled "2026-10-31"^^xsd:date ;
    bsm:axiomOf bsm:BSM_0000210 ;
    bsm:dependsOn bsm:BSM_0000049 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#wric> .

bsm:BSM_0000016
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "iid shocks"@en ;
    skos:notation "iid-shocks" ;
    skos:definition "ψ and ξ are independent of each other and over time, and identically distributed. Shocks declared separately in a stage file are conditionally independent, an assumption recorded and not checked."@en ;
    bsm:tier "hypothesis" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000002 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> .

bsm:BSM_0000017
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "bounded support"@en ;
    skos:notation "bounded-support" ;
    skos:definition "ψ ∈ [ψ_min, ψ_max] with 0 < ψ_min ≤ 1 ≤ ψ_max < ∞, and the employed draw θ ∈ [θ_min, θ_max] with 0 < θ_min ≤ 1 ≤ θ_max < ∞, as BST assumes. A hypothesis of the paper's theorems until 2026-11-01, when it became a condition of membership of the natural scenarios. It excludes the untruncated lognormal, whose model with a ≥ 0 is the zero-infima scenario's."@en ;
    bsm:check "psi_min > 0 and theta_min > 0 and psi_max < inf and theta_max < inf" ;
    bsm:tier "membership" ;
    bsm:status "ruling" ;
    bsm:ruled "2026-11-01"^^xsd:date ;
    bsm:axiomOf bsm:BSM_0000209 ;
    bsm:dependsOn bsm:BSM_0000221 ;
    bsm:dependsOn bsm:BSM_0000046 ;
    bsm:dependsOn bsm:BSM_0000223 ;
    bsm:dependsOn bsm:BSM_0000222 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#bounded-support> .

bsm:BSM_0000018
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "the zero-income event"@en ;
    skos:notation "zero-income-event" ;
    skos:definition "ξ = 0 with probability ℘ > 0, and ξ = θ/(1 − ℘) otherwise, with E[θ] = 1."@en ;
    bsm:check "wp > 0 and xi_u == 0" ;
    bsm:tier "hypothesis" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000002 ;
    bsm:dependsOn bsm:BSM_0000042 ;
    bsm:dependsOn bsm:BSM_0000043 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-transhkdef> .

bsm:BSM_0000019
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "no artificial constraint"@en ;
    skos:notation "no-artificial-constraint" ;
    skos:definition "There is no artificial borrowing constraint; the natural constraint is the one in force."@en ;
    bsm:check "a_min == a_Nat" ;
    bsm:tier "hypothesis" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000002 ;
    bsm:dependsOn bsm:BSM_0000057 ;
    bsm:dependsOn bsm:BSM_0000058 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-intro> .

bsm:BSM_0000020
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "infinite lives"@en ;
    skos:notation "infinite-lives" ;
    skos:definition "ℒ = 1; the object of study is the limit of the finite-horizon solutions as the horizon recedes."@en ;
    bsm:check "L == 1" ;
    bsm:tier "hypothesis" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000002 ;
    bsm:dependsOn bsm:BSM_0000039 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#def-nondegeneracy> .

bsm:BSM_0000021
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "one type"@en ;
    skos:notation "one-type" ;
    skos:definition "Every agent has the same primitives."@en ;
    bsm:tier "hypothesis" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000002 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsec-setup> .

bsm:BSM_0000022
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "no shocks"@en ;
    skos:notation "no-shocks" ;
    skos:definition "℘ = 0 and ψ = θ = 1 with probability one."@en ;
    bsm:check "wp == 0" ;
    bsm:tier "membership" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000003 ;
    bsm:dependsOn bsm:BSM_0000042 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-pfincome> .

bsm:BSM_0000148
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "income risk"@en ;
    skos:notation "income-risk" ;
    skos:definition "At least one of the permanent and the transitory shock is not degenerate. A model without income risk has no precautionary motive and is the perfect-foresight benchmark, not a buffer-stock model."@en ;
    bsm:tier "membership" ;
    bsm:status "proposed" ;
    bsm:axiomOf bsm:BSM_0000001 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-intro> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-pfincome> .

bsm:BSM_0000149
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "a riskless, constant return"@en ;
    skos:notation "riskless-constant-return" ;
    skos:definition "The return factor R is known and the same in every period, for positive and negative assets alike."@en ;
    bsm:tier "hypothesis" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000002 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-dbcparts> .

bsm:BSM_0000181
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "no borrowing"@en ;
    skos:notation "artificial-constraint-at-zero" ;
    skos:definition "End-of-period assets satisfy a ≥ 0: consumption c ≤ m."@en ;
    bsm:check "a_Art == 0" ;
    bsm:tier "membership" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000180 ;
    bsm:dependsOn bsm:BSM_0000044 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#perfect-foresight-with-liquidity-constraints> .

bsm:BSM_0000201
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "no borrowing, binding"@en ;
    skos:notation "no-borrowing" ;
    skos:definition "The constraint in force is a ≥ 0, so consumption c ≤ m, and there is no zero-income event, so that the constraint binds: an artificial constraint at zero with positive floors, or zero infima."@en ;
    bsm:check "a_min == 0 and (wp == 0 or xi_u > 0)" ;
    bsm:tier "membership" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000200 ;
    bsm:dependsOn bsm:BSM_0000058 ;
    bsm:dependsOn bsm:BSM_0000042 ;
    bsm:dependsOn bsm:BSM_0000043 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsubsec-deatonislimit> .

bsm:BSM_0000213
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "the natural constraint in force"@en ;
    skos:notation "natural-in-force" ;
    skos:definition "No artificial constraint is tighter than the natural one, so the constraint in force is a_Nat = −h_min."@en ;
    bsm:check "a_min == a_Nat" ;
    bsm:tier "membership" ;
    bsm:status "bst" ;
    bsm:axiomOf bsm:BSM_0000209 ;
    bsm:dependsOn bsm:BSM_0000057 ;
    bsm:dependsOn bsm:BSM_0000058 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#borocnstnat> .

bsm:BSM_0000214
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "no point mass at the joint worst income"@en ;
    skos:notation "no-point-mass-at-joint-worst-income" ;
    skos:definition "The joint worst income has probability zero under the true law, p_worst = 0."@en ;
    bsm:check "p_worst == 0" ;
    bsm:tier "membership" ;
    bsm:status "ruling" ;
    bsm:ruled "2026-11-01"^^xsd:date ;
    bsm:axiomOf bsm:BSM_0000211 ;
    bsm:dependsOn bsm:BSM_0000049 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> .

bsm:BSM_0000215
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "an artificial constraint tighter than the natural one"@en ;
    skos:notation "artificial-tighter" ;
    skos:definition "The artificial constraint lies strictly above the natural one, a_Art > a_Nat; one no tighter has no effect."@en ;
    bsm:check "a_Art > a_Nat" ;
    bsm:tier "membership" ;
    bsm:status "ruling" ;
    bsm:ruled "2026-10-22"^^xsd:date ;
    bsm:axiomOf bsm:BSM_0000007 ;
    bsm:dependsOn bsm:BSM_0000044 ;
    bsm:dependsOn bsm:BSM_0000057 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsubsec-deatonislimit> .

bsm:BSM_0000216
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "positive floors"@en ;
    skos:notation "positive-floors" ;
    skos:definition "ψ_min > 0 and ξ_min > 0, so that h_min > 0 and the natural constraint lies below zero; with a zero floor the model is the zero-infima scenario's, or the natural one's when the zero is a zero-income event."@en ;
    bsm:check "psi_min > 0 and xi_min > 0" ;
    bsm:tier "membership" ;
    bsm:status "ruling" ;
    bsm:ruled "2026-11-01"^^xsd:date ;
    bsm:axiomOf bsm:BSM_0000007 ;
    bsm:dependsOn bsm:BSM_0000046 ;
    bsm:dependsOn bsm:BSM_0000047 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> .

bsm:BSM_0000217
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "a zero infimum"@en ;
    skos:notation "zero-infimum" ;
    skos:definition "The permanent shock or the employed draw has infimum zero, so that the natural constraint is a ≥ 0."@en ;
    bsm:check "psi_min == 0 or theta_min == 0" ;
    bsm:tier "membership" ;
    bsm:status "ruling" ;
    bsm:ruled "2026-11-01"^^xsd:date ;
    bsm:axiomOf bsm:BSM_0000212 ;
    bsm:dependsOn bsm:BSM_0000046 ;
    bsm:dependsOn bsm:BSM_0000222 ;
    dcterms:source <https://arxiv.org/abs/1905.13045v3> .

bsm:BSM_0000218
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "no zero-income event"@en ;
    skos:notation "no-zero-income-event" ;
    skos:definition "The unemployment event, where there is one, pays a positive income, since a zero one makes E[ξ^(−ϱ)] infinite."@en ;
    bsm:check "wp == 0 or xi_u > 0" ;
    bsm:tier "membership" ;
    bsm:status "ruling" ;
    bsm:ruled "2026-11-01"^^xsd:date ;
    bsm:axiomOf bsm:BSM_0000212 ;
    bsm:dependsOn bsm:BSM_0000042 ;
    bsm:dependsOn bsm:BSM_0000043 ;
    dcterms:source <https://arxiv.org/abs/1905.13045v3> .

bsm:BSM_0000219
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "finite negative moments"@en ;
    skos:notation "finite-negative-moments" ;
    skos:definition "E[θ^(−ϱ)] < ∞, and E[ψ^(−ϱ)] < ∞ when ψ's infimum is zero: the expected marginal value of ending a period at a = 0 is then finite, and the constraint binds. A law with a positive density at zero fails it for ϱ ≥ 1."@en ;
    bsm:tier "membership" ;
    bsm:status "ruling" ;
    bsm:ruled "2026-11-01"^^xsd:date ;
    bsm:axiomOf bsm:BSM_0000212 ;
    dcterms:source <https://arxiv.org/abs/1905.13045v3> .

bsm:BSM_0000220
    a owl:NamedIndividual, bsm:Axiom ;
    rdfs:label "in a borrowing-constraint scenario"@en ;
    skos:notation "in-a-constraint-scenario" ;
    skos:definition "The model is in one of the four borrowing-constraint scenarios: natural-with-point-mass, natural-without-point-mass, with-artificial-constraint, or zero-infima. A model in none, such as unbounded laws with a zero-income event and no artificial constraint, is not a buffer-stock model. The schemas write each scenario as a family of its own, with its own stage file."@en ;
    bsm:tier "membership" ;
    bsm:status "ruling" ;
    bsm:ruled "2026-11-01"^^xsd:date ;
    bsm:axiomOf bsm:BSM_0000001 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> .

bsm:BSM_0000023
    a owl:NamedIndividual, bsm:Agent ;
    rdfs:label "agent"@en ;
    skos:notation "agent" ;
    skos:definition "The consumer whose problem the model states."@en ;
    bsm:category "agent" .

bsm:BSM_0000024
    a owl:NamedIndividual, bsm:Population ;
    rdfs:label "population"@en ;
    skos:notation "population" ;
    skos:definition "A continuum of agents of unit mass, each following the model's rule."@en ;
    bsm:category "population" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#the-aggregate-and-idiosyncratic-relationship-between-consumption-growth-and-income-growth> .

bsm:BSM_0000025
    a owl:NamedIndividual, bsm:Time ;
    rdfs:label "period"@en ;
    skos:notation "period" ;
    skos:definition "The time index t; finite-horizon problems run to a terminal period T. A trellis counts its periods h back from the terminal one, so t = T − h, and BST's horizon T − n is the period with h = n."@en ;
    bsm:category "time" ;
    bsm:bellmanConcept "period" ;
    bsm:registryKey "period-now" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsec-setup> .

bsm:BSM_0000026
    a owl:NamedIndividual, bsm:State ;
    rdfs:label "market resources"@en ;
    skos:notation "market-resources" ;
    skos:definition "Bank balances plus noncapital income, as a ratio to permanent income; the state of the normalized problem."@en ;
    bsm:symbol "m" ;
    bsm:category "state" ;
    bsm:stateDomain "ℝ, or ℝ₊₊, in the families' stage files, the set Xm" ;
    bsm:atPerch bsm:BSM_0000161 ;
    bsm:inBST "\\mNrm" ;
    bsm:registryKey "resources-now" ;
    bsm:inBellmanSym "m" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-dbcparts> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsubsec-ratio> .

bsm:BSM_0000027
    a owl:NamedIndividual, bsm:State ;
    rdfs:label "permanent income"@en ;
    skos:notation "permanent-income" ;
    skos:definition "The level 𝐩 by which the problem is normalized; 𝐩′ = 𝒢 ψ′ 𝐩."@en ;
    bsm:category "state" ;
    bsm:inBST "\\pLvl" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-dbcparts> .

bsm:BSM_0000028
    a owl:NamedIndividual, bsm:State ;
    rdfs:label "kapital"@en ;
    skos:notation "kapital" ;
    skos:definition "Arrival assets: the end-of-period assets of the period before, which the connector joins to this period, as a ratio to that period's permanent income."@en ;
    bsm:category "state" ;
    bsm:stateDomain "Xa, the constraint in force's set, in the families' stage files" ;
    bsm:atPerch bsm:BSM_0000160 ;
    bsm:registryKey "kapital-now" ;
    bsm:inBellmanSym "k" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-dbcparts> .

bsm:BSM_0000029
    a owl:NamedIndividual, bsm:State ;
    rdfs:label "bank balances"@en ;
    skos:notation "bank-balances" ;
    skos:definition "b = R k/(𝒢 ψ), kapital with its return, as a ratio to this period's permanent income."@en ;
    bsm:category "state" ;
    bsm:inBST "\\bNrm" ;
    bsm:registryKey "bank-balances" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-dbcparts> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-veqnnrmrecbellman> .

bsm:BSM_0000030
    a owl:NamedIndividual, bsm:State ;
    rdfs:label "end-of-period assets"@en ;
    skos:notation "end-of-period-assets" ;
    skos:definition "a = m − c, as a ratio to permanent income."@en ;
    bsm:category "state" ;
    bsm:stateDomain "Xa, the constraint in force's set, in the families' stage files" ;
    bsm:atPerch bsm:BSM_0000162 ;
    bsm:registryKey "assets-now" ;
    bsm:inBellmanSym "a" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-veqnnrmrecbellman> .

bsm:BSM_0000031
    a owl:NamedIndividual, bsm:Control ;
    rdfs:label "consumption"@en ;
    skos:notation "consumption" ;
    skos:definition "c, as a ratio to permanent income; the agent's one choice."@en ;
    bsm:category "control" ;
    bsm:stateDomain "ℝ₊₊, within the feasible set 𝒞(m)" ;
    bsm:atPerch bsm:BSM_0000161 ;
    bsm:registryKey "consumption-now" ;
    bsm:inBellmanSym "c" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-veqnnrmrecbellman> .

bsm:BSM_0000032
    a owl:NamedIndividual, bsm:Shock ;
    rdfs:label "permanent shock"@en ;
    skos:notation "permanent-shock" ;
    skos:definition "ψ, the mean-one shock to permanent income; its law is a mean-one law of the ontology of probability distributions."@en ;
    bsm:category "shock" ;
    bsm:lawIn pd:PD_0000012 ;
    bsm:lawIn pd:PD_0000018 ;
    bsm:lawIn pd:PD_0000031 ;
    bsm:inBST "\\permShk" ;
    bsm:registryKey "permanent-shock" ;
    bsm:inParameterFile "income.permanent_shock" ;
    bsm:inBellmanSym "ψ" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> .

bsm:BSM_0000033
    a owl:NamedIndividual, bsm:Shock ;
    rdfs:label "transitory shock"@en ;
    skos:notation "transitory-shock" ;
    skos:definition "ξ, transitory income as a ratio to permanent income, the unemployment event included: ξ_u with probability ℘, else the scaled employed draw. The families' stage files compose it from the shocks j and θ in a line of the arrival transition, where it is an intermediate field; a stage file may instead declare ξ itself, with a mixture law."@en ;
    bsm:category "shock" ;
    bsm:inBST "\\tranShkAll" ;
    bsm:registryKey "transitory-shock-all" ;
    bsm:inBellmanSym "ξ" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-transhkdef> .

bsm:BSM_0000034
    a owl:NamedIndividual, bsm:Shock ;
    rdfs:label "employed transitory draw"@en ;
    skos:notation "transitory-shock-employed" ;
    skos:definition "θ, the mean-one draw of transitory income while employed."@en ;
    bsm:category "shock" ;
    bsm:lawIn pd:PD_0000012 ;
    bsm:lawIn pd:PD_0000018 ;
    bsm:lawIn pd:PD_0000031 ;
    bsm:inBST "\\tranShkEmp" ;
    bsm:registryKey "transitory-shock-employed" ;
    bsm:inParameterFile "income.employed_shock" ;
    bsm:inBellmanSym "θ" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> .

bsm:BSM_0000035
    a owl:NamedIndividual, bsm:Shock ;
    rdfs:label "unemployment event"@en ;
    skos:notation "unemployment-event" ;
    skos:definition "j, a shock on the two-point set {employed, unemployed}, unemployed with probability ℘, independent of ψ and θ; transitory income is ξ_u when it is unemployed, BST's zero-income event when ξ_u = 0."@en ;
    bsm:category "shock" ;
    bsm:inBellmanSym "j" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-transhkdef> .

bsm:BSM_0000036
    a owl:NamedIndividual, bsm:Shock ;
    rdfs:label "survival event"@en ;
    skos:notation "survival-event" ;
    skos:definition "A shock on a two-point set, alive with probability ℒ, that decides whether an agent alive this period is alive the next. The families' stage files draw none: they state survivors' problem, with ℒ in the discount, and the deaths and newborns of the population are stated outside them."@en ;
    bsm:category "shock" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-mortality> .

bsm:BSM_0000037
    a owl:NamedIndividual, bsm:Primitive ;
    rdfs:label "relative risk aversion"@en ;
    skos:notation "crra" ;
    skos:definition "ϱ, the coefficient of relative risk aversion of the CRRA utility function."@en ;
    bsm:symbol "rho" ;
    bsm:category "primitive" ;
    bsm:inBST "\\CRRA" ;
    bsm:registryKey "crra" ;
    bsm:inParameterFile "crra" ;
    bsm:inBellmanSym "ϱ" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsec-setup> .

bsm:BSM_0000038
    a owl:NamedIndividual, bsm:Primitive ;
    rdfs:label "discount factor"@en ;
    skos:notation "discount-factor" ;
    skos:definition "β, the pure time-preference factor of one type."@en ;
    bsm:symbol "beta" ;
    bsm:category "primitive" ;
    bsm:inBST "\\DiscFac" ;
    bsm:registryKey "discount-factor" ;
    bsm:inParameterFile "types[].beta" ;
    bsm:inBellmanSym "β" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsec-setup> .

bsm:BSM_0000039
    a owl:NamedIndividual, bsm:Primitive ;
    rdfs:label "survival probability"@en ;
    skos:notation "survival-prob" ;
    skos:definition "ℒ, the probability of surviving into the next period."@en ;
    bsm:symbol "L" ;
    bsm:category "primitive" ;
    bsm:inBST "\\Alive" ;
    bsm:registryKey "survival-prob" ;
    bsm:inParameterFile "survival" ;
    bsm:inBellmanSym "ℒ" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-mortality> .

bsm:BSM_0000040
    a owl:NamedIndividual, bsm:Primitive ;
    rdfs:label "return factor"@en ;
    skos:notation "return-factor" ;
    skos:definition "R, the gross return on the riskless asset."@en ;
    bsm:symbol "R" ;
    bsm:category "primitive" ;
    bsm:inBST "\\Rfree" ;
    bsm:registryKey "return-factor" ;
    bsm:inParameterFile "return" ;
    bsm:inBellmanSym "R" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-dbcparts> .

bsm:BSM_0000041
    a owl:NamedIndividual, bsm:Primitive ;
    rdfs:label "growth factor of permanent income"@en ;
    skos:notation "growth-factor" ;
    skos:definition "𝒢, the expected growth factor of permanent income."@en ;
    bsm:symbol "G" ;
    bsm:category "primitive" ;
    bsm:inBST "\\PermGroFac" ;
    bsm:registryKey "growth-factor" ;
    bsm:inParameterFile "income.growth" ;
    bsm:inBellmanSym "𝒢" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-dbcparts> .

bsm:BSM_0000042
    a owl:NamedIndividual, bsm:Primitive ;
    rdfs:label "probability of unemployment"@en ;
    skos:notation "unemployment-prob" ;
    skos:definition "℘, the probability of the unemployment event, whatever ξ_u is."@en ;
    bsm:symbol "wp" ;
    bsm:category "primitive" ;
    bsm:inBST "\\pZero" ;
    bsm:registryKey "unemployment-prob" ;
    bsm:inParameterFile "income.unemployment.prob" ;
    bsm:inBellmanSym "p_zero" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-transhkdef> .

bsm:BSM_0000043
    a owl:NamedIndividual, bsm:Primitive ;
    rdfs:label "income while unemployed"@en ;
    skos:notation "income-unemployed" ;
    skos:definition "ξ_u ≥ 0, transitory income in the unemployment event, as a ratio to permanent income."@en ;
    bsm:symbol "xi_u" ;
    bsm:category "primitive" ;
    bsm:inBST "\\IncUnemp" ;
    bsm:registryKey "income-unemployed" ;
    bsm:inParameterFile "income.unemployment.income" ;
    bsm:inBellmanSym "ξ_u" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> .

bsm:BSM_0000044
    a owl:NamedIndividual, bsm:Primitive ;
    rdfs:label "artificial borrowing constraint"@en ;
    skos:notation "borrowing-limit-artificial" ;
    skos:definition "a_Art ≤ 0, a lower bound on end-of-period assets imposed from outside the household's problem."@en ;
    bsm:symbol "a_Art" ;
    bsm:category "primitive" ;
    bsm:inBST "\\BoroCnstArt" ;
    bsm:registryKey "borrowing-limit-artificial" ;
    bsm:inParameterFile "borrowing_constraint" ;
    bsm:inBellmanSym "a_Art" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsubsec-deatonislimit> .

bsm:BSM_0000150
    a owl:NamedIndividual, bsm:Primitive ;
    rdfs:label "return factor on borrowing"@en ;
    skos:notation "return-borrowing" ;
    skos:definition "The gross return factor negative assets pay, in the extension with a higher rate on borrowing."@en ;
    bsm:symbol "R_boro" ;
    bsm:category "primitive" ;
    bsm:registryKey "return-borrowing" .

bsm:BSM_0000045
    a owl:NamedIndividual, bsm:Primitive ;
    rdfs:label "share of a type"@en ;
    skos:notation "type-share" ;
    skos:definition "ω_i, the share of type i in the population."@en ;
    bsm:category "primitive" ;
    bsm:registryKey "weight" ;
    bsm:inParameterFile "types[].share" .

bsm:BSM_0000046
    a owl:NamedIndividual, bsm:Bound ;
    rdfs:label "lowest permanent shock"@en ;
    skos:notation "permanent-shock-min" ;
    skos:definition "ψ_min, the infimum of the permanent shock's support under the true law; zero for a law unbounded below."@en ;
    bsm:symbol "psi_min" ;
    bsm:category "bound" ;
    bsm:lawProperty pd:PD_0000007 ;
    bsm:inBST "\\permShkIndMin" ;
    bsm:registryKey "permanent-shock-min" ;
    bsm:inBellmanSym "ψ_min" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> .

bsm:BSM_0000221
    a owl:NamedIndividual, bsm:Bound ;
    rdfs:label "highest permanent shock"@en ;
    skos:notation "permanent-shock-max" ;
    skos:definition "ψ_max, the supremum of the permanent shock's support under the true law; infinite for a law unbounded above."@en ;
    bsm:symbol "psi_max" ;
    bsm:category "bound" ;
    bsm:lawProperty pd:PD_0000007 ;
    bsm:inBellmanSym "ψ_max" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> .

bsm:BSM_0000222
    a owl:NamedIndividual, bsm:Bound ;
    rdfs:label "lowest employed draw"@en ;
    skos:notation "employed-draw-min" ;
    skos:definition "θ_min, the infimum of the employed draw's support under the true law; zero for a law unbounded below."@en ;
    bsm:symbol "theta_min" ;
    bsm:category "bound" ;
    bsm:lawProperty pd:PD_0000007 ;
    bsm:inBellmanSym "θ_min" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> .

bsm:BSM_0000223
    a owl:NamedIndividual, bsm:Bound ;
    rdfs:label "highest employed draw"@en ;
    skos:notation "employed-draw-max" ;
    skos:definition "θ_max, the supremum of the employed draw's support under the true law."@en ;
    bsm:symbol "theta_max" ;
    bsm:category "bound" ;
    bsm:lawProperty pd:PD_0000007 ;
    bsm:inBellmanSym "θ_max" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> .

bsm:BSM_0000047
    a owl:NamedIndividual, bsm:Bound ;
    rdfs:label "lowest transitory shock"@en ;
    skos:notation "transitory-shock-min" ;
    skos:definition "ξ_min, the infimum of the transitory shock's support under the true law: the lower of ξ_u (when ℘ > 0) and the lowest scaled employed draw."@en ;
    bsm:symbol "xi_min" ;
    bsm:category "bound" ;
    bsm:lawProperty pd:PD_0000007 ;
    bsm:inBST "\\tranShkMin" ;
    bsm:registryKey "transitory-shock-min" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-shocks> .

bsm:BSM_0000048
    a owl:NamedIndividual, bsm:Bound ;
    rdfs:label "probability of the lowest transitory shock"@en ;
    skos:notation "transitory-atom-prob" ;
    skos:definition "P(ξ = ξ_min), the mass the true law of the transitory shock puts at its infimum."@en ;
    bsm:symbol "xi_atom" ;
    bsm:category "bound" ;
    bsm:lawProperty pd:PD_0000011 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> .

bsm:BSM_0000049
    a owl:NamedIndividual, bsm:Bound ;
    rdfs:label "probability of the worst income"@en ;
    skos:notation "worst-income-prob" ;
    skos:definition "The probability that income ψξ takes its lowest value: ℘ when the unemployment event pays nothing, otherwise the product of the two laws' masses at their infima."@en ;
    bsm:symbol "p_worst" ;
    bsm:category "bound" ;
    bsm:lawProperty pd:PD_0000011 ;
    bsm:registryKey "worst-income-prob" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#wric> .

bsm:BSM_0000050
    a owl:NamedIndividual, bsm:Function ;
    rdfs:label "utility function"@en ;
    skos:notation "utility-function" ;
    skos:definition "u(c) = c^(1−ϱ)/(1−ϱ)."@en ;
    bsm:category "function" ;
    bsm:inBST "\\uFunc" ;
    bsm:registryKey "utility-function" ;
    bsm:inBellmanSym "𝑢" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsec-setup> .

bsm:BSM_0000051
    a owl:NamedIndividual, bsm:Value ;
    rdfs:label "decision value"@en ;
    skos:notation "value-decision" ;
    skos:definition "V, the value field at the decision perch, represented by v_t(m), the normalized value of the finite-horizon problem, value in levels divided by 𝐩^(1−ϱ); its limit as the horizon recedes is the limiting value function v. v_t(m) = u(c_t(m)) + β̊ V[>](m − c_t(m))."@en ;
    bsm:category "value" ;
    bsm:bellmanConcept "field" ;
    bsm:atPerch bsm:BSM_0000161 ;
    bsm:functionOf bsm:BSM_0000026 ;
    bsm:inBST "\\vFunc" ;
    bsm:inBellmanSym "V" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-veqnnrmrecbellman> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#def-nondegeneracy> .

bsm:BSM_0000052
    a owl:NamedIndividual, bsm:Function ;
    rdfs:label "consumption function"@en ;
    skos:notation "consumption-function" ;
    skos:definition "c_t(m), the policy: the optimal consumption of the finite-horizon problem, a function of the decision state into the feasible set, c_t(m) ∈ 𝒞(m). Its limit as the horizon recedes is the limiting consumption function c, the rule a population follows. The control c is its value at one m."@en ;
    bsm:category "function" ;
    bsm:atPerch bsm:BSM_0000161 ;
    bsm:functionOf bsm:BSM_0000026 ;
    bsm:inBST "\\cFunc" ;
    bsm:registryKey "consumption-function" ;
    bsm:inBellmanSym "policy" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-cfunceq1> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#def-nondegeneracy> .

bsm:BSM_0000053
    a owl:NamedIndividual, bsm:Operator ;
    rdfs:label "stationary Bellman operator"@en ;
    skos:notation "bellman-operator" ;
    skos:definition "T, BST's map from next period's normalized decision value to this period's, over consumption in (0, m). It is the stage operator cut at the decision perch: the decision operator of period t after the arrival operator of period t+1, joined by the connector, where the backward stage operator runs from continuation value to arrival value. The two compositions are rotations of each other, so their fixed points correspond, through v ↦ 𝕋_≺ v. As written, T has no artificial constraint; with one, its feasible set is 𝒞(m)."@en ;
    bsm:category "operator" ;
    bsm:inBST "\\TMap" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#stationary-bellman-operator> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-maintmap> .

bsm:BSM_0000054
    a owl:NamedIndividual, bsm:Relation ;
    rdfs:label "Euler equation"@en ;
    skos:notation "euler-equation" ;
    skos:definition "u′(c_t) = R β̊ E_t[(𝒢ψ′)^(−ϱ) u′(c_{t+1})] in the normalized problem, holding wherever the constraint in force is slack, natural or artificial: u′(c) = β̊ D_{a}V[>] with the complementary-slackness clause m − c ≥ a_min. A Kuhn–Tucker relation of the policy, not an operator; `policy.euler` is the address of its line, and the derivative lines D_{m}V = u′(c) and D_{k}V[<] = E[R (𝒢ψ)^(−ϱ) D_{m}V] complete it across the connector."@en ;
    bsm:category "relation" ;
    bsm:inBellmanSym "policy.euler" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-scaledeuler> .

bsm:BSM_0000055
    a owl:NamedIndividual, bsm:Operation ;
    rdfs:label "expectation over beliefs"@en ;
    skos:notation "expectation" ;
    skos:definition "E_t, the expectation over next period's shocks, for one agent's beliefs; an operation inside the arrival operator, integrating against the declared laws of the shocks."@en ;
    bsm:category "operation" ;
    bsm:inBST "\\Ex" ;
    bsm:registryKey "expectation" ;
    bsm:inBellmanSym "E_{ψ,θ,j}" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-levelrecproblem> .

bsm:BSM_0000056
    a owl:NamedIndividual, bsm:Operation ;
    rdfs:label "cross-sectional mean"@en ;
    skos:notation "cross-sectional-mean" ;
    skos:definition "𝕄, the mean of a variable across the population's empirical distribution, as distinct from the expectation over one agent's beliefs: the pairing ⟨μ, f⟩ = ∫ f dμ of the population's measure with a function of the state."@en ;
    bsm:category "operation" ;
    bsm:inBST "\\Mean" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsec-cgroeqpermgrofacq> .

bsm:BSM_0000057
    a owl:NamedIndividual, bsm:Constraint ;
    rdfs:label "natural borrowing constraint"@en ;
    skos:notation "borrowing-limit-natural" ;
    skos:definition "a_Nat, the lowest end-of-period assets from which the worst income next period still allows positive consumption forever: minus the present value of the worst income, capitalized at ℛ, that is −h_min. A quantity of the laws. No stage file carries it as a parameter: the natural family's members have it at zero, through the zero-income event, and the artificial family states a_Art above it. The family of the natural scenario without a point mass wrote it out from the laws' bounds until its abolition on 2026-11-03."@en ;
    bsm:symbol "a_Nat" ;
    bsm:category "constraint" ;
    bsm:inBST "\\BoroCnstNat" ;
    bsm:registryKey "borrowing-limit-natural" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#borocnstnat> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> .

bsm:BSM_0000058
    a owl:NamedIndividual, bsm:Constraint ;
    rdfs:label "constraint in force"@en ;
    skos:notation "borrowing-limit" ;
    skos:definition "a_min = max(a_Art, a_Nat), the borrowing constraint the agent faces."@en ;
    bsm:symbol "a_min" ;
    bsm:category "constraint" ;
    bsm:registryKey "borrowing-limit" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> .

bsm:BSM_0000059
    a owl:NamedIndividual, bsm:LawOfMotion ;
    rdfs:label "dynamic budget constraint"@en ;
    skos:notation "dynamic-budget-constraint" ;
    skos:definition "a = m − c; k′ = a; 𝐩′ = 𝒢ψ′𝐩; m′ = R k′/(𝒢ψ′) + ξ′. BST's name for the composite of the decision law of motion, the connector and the next period's arrival law of motion, with the growth of permanent income, which the normalized problem carries only as the factors (𝒢ψ)^(1−ϱ) and (𝒢ψ)^(−ϱ). A law of motion, not a constraint."@en ;
    bsm:category "law-of-motion" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-dbcparts> .

bsm:BSM_0000060
    a owl:NamedIndividual, bsm:Measure ;
    rdfs:label "population measure"@en ;
    skos:notation "population-measure" ;
    skos:definition "The measure that gives each agent of the population weight one: a probability measure μ on a perch's states, moved through a period by the forward distribution operator; its stationary distribution is a fixed point of that operator across the connector."@en ;
    bsm:category "measure" ;
    bsm:atPerch bsm:BSM_0000160 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#gicsdl> .

bsm:BSM_0000061
    a owl:NamedIndividual, bsm:Measure ;
    rdfs:label "income measure"@en ;
    skos:notation "income-measure" ;
    skos:definition "The measure that weights each agent by its permanent income, normalized to total weight one: Harmenberg's permanent-income-neutral measure. The normalized stage has no field of permanent income to weight by. Since E[ψ] = 1, ψ times ψ's law is a probability law, and the income measure moves as the population measure of the same stage with that law in place of ψ's: a second forward problem, not a second weighting of one (deduced)."@en ;
    bsm:category "measure" ;
    bsm:atPerch bsm:BSM_0000160 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-harmcdf> .

bsm:BSM_0000160
    a owl:NamedIndividual, bsm:Perch ;
    rdfs:label "arrival perch"@en ;
    skos:notation "perch-arrival" ;
    skos:definition "The information on entering a stage, before its shocks are drawn; in the buffer-stock families its state is kapital k."@en ;
    bsm:category "perch" ;
    bsm:bellmanConcept "perch" ;
    bsm:inBellmanSym "!arvl" .

bsm:BSM_0000161
    a owl:NamedIndividual, bsm:Perch ;
    rdfs:label "decision perch"@en ;
    skos:notation "perch-decision" ;
    skos:definition "The information at which the control is chosen, the shocks drawn; in the buffer-stock families its state is m."@en ;
    bsm:category "perch" ;
    bsm:bellmanConcept "perch" ;
    bsm:inBellmanSym "!dcsn" .

bsm:BSM_0000162
    a owl:NamedIndividual, bsm:Perch ;
    rdfs:label "continuation perch"@en ;
    skos:notation "perch-continuation" ;
    skos:definition "The information after the choice; in the buffer-stock families its state is end-of-period assets a."@en ;
    bsm:category "perch" ;
    bsm:bellmanConcept "perch" ;
    bsm:inBellmanSym "!cntn" .

bsm:BSM_0000163
    a owl:NamedIndividual, bsm:Structure ;
    rdfs:label "stage"@en ;
    skos:notation "stage" ;
    skos:definition "One decision problem with its three perches and its transitions, used at each period where it occurs. Each buffer-stock family writes one stage per period, in its own stage file, so its perches coincide with BST's beginning of the period, its moment of choice and its end; a period of several stages would not."@en ;
    bsm:category "structure" ;
    bsm:bellmanConcept "stage" .

bsm:BSM_0000164
    a owl:NamedIndividual, bsm:Structure ;
    rdfs:label "trellis"@en ;
    skos:notation "trellis" ;
    skos:definition "The finite sequence of a model's periods, indexed by h, the number of periods before the terminal one, with the connectors that join them and the terminal value as boundary data. BST's infinite horizon is its limit, which a trellis does not state."@en ;
    bsm:category "structure" ;
    bsm:bellmanConcept "trellis" .

bsm:BSM_0000165
    a owl:NamedIndividual, bsm:Value ;
    rdfs:label "arrival value"@en ;
    skos:notation "value-arrival" ;
    skos:definition "V[<], the value field at the arrival perch, represented by v≺(k) = E[(𝒢ψ)^(1−ϱ) v(m)]: the expectation over the shocks of the decision value, with the normalization (𝒢ψ)^(1−ϱ) inside it."@en ;
    bsm:category "value" ;
    bsm:bellmanConcept "field" ;
    bsm:atPerch bsm:BSM_0000160 ;
    bsm:functionOf bsm:BSM_0000028 ;
    bsm:inBellmanSym "V[<]" .

bsm:BSM_0000166
    a owl:NamedIndividual, bsm:Value ;
    rdfs:label "continuation value"@en ;
    skos:notation "value-continuation" ;
    skos:definition "V[>], the value field at the continuation perch, represented by a function of end-of-period assets a, supplied by the next period's arrival value through the connector, or by the terminal boundary."@en ;
    bsm:category "value" ;
    bsm:bellmanConcept "field" ;
    bsm:atPerch bsm:BSM_0000162 ;
    bsm:functionOf bsm:BSM_0000030 ;
    bsm:inBellmanSym "V[>]" .

bsm:BSM_0000167
    a owl:NamedIndividual, bsm:Function ;
    rdfs:label "marginal decision value"@en ;
    skos:notation "marginal-value-decision" ;
    skos:definition "D_{m}V, the derivative of the decision value in m, read by the derivative term and no field of its own; u′(c(m)) by the envelope condition."@en ;
    bsm:category "function" ;
    bsm:atPerch bsm:BSM_0000161 ;
    bsm:functionOf bsm:BSM_0000026 ;
    bsm:inBellmanSym "D_{m}V" .

bsm:BSM_0000168
    a owl:NamedIndividual, bsm:Function ;
    rdfs:label "marginal arrival value"@en ;
    skos:notation "marginal-value-arrival" ;
    skos:definition "D_{k}V[<] = E[R (𝒢ψ)^(−ϱ) D_{m}V], the derivative of the arrival value in k."@en ;
    bsm:category "function" ;
    bsm:atPerch bsm:BSM_0000160 ;
    bsm:functionOf bsm:BSM_0000028 ;
    bsm:inBellmanSym "D_{k}V[<]" .

bsm:BSM_0000169
    a owl:NamedIndividual, bsm:Function ;
    rdfs:label "marginal continuation value"@en ;
    skos:notation "marginal-value-continuation" ;
    skos:definition "D_{a}V[>], the derivative of the continuation value in a: the next period's marginal arrival value, through the connector."@en ;
    bsm:category "function" ;
    bsm:atPerch bsm:BSM_0000162 ;
    bsm:functionOf bsm:BSM_0000030 ;
    bsm:inBellmanSym "D_{a}V[>]" .

bsm:BSM_0000170
    a owl:NamedIndividual, bsm:Function ;
    rdfs:label "end-of-period value"@en ;
    skos:notation "end-of-period-value" ;
    skos:definition "𝔳(a) = β̊ V[>](a), the discounted value of end-of-period assets, β̊ E[(𝒢ψ′)^(1−ϱ) v(m′)]. In the families' stage files the discount stands in the decision block, so the continuation value is undiscounted."@en ;
    bsm:category "function" ;
    bsm:atPerch bsm:BSM_0000162 ;
    bsm:functionOf bsm:BSM_0000030 .

bsm:BSM_0000171
    a owl:NamedIndividual, bsm:Function ;
    rdfs:label "end-of-period marginal value"@en ;
    skos:notation "end-of-period-marginal-value" ;
    skos:definition "𝔳′(a) = β̊ D_{a}V[>](a) = β̊ R E[(𝒢ψ′)^(−ϱ) u′(c(m′))], the marginal value of end-of-period assets, which the Euler equation sets equal to u′(c)."@en ;
    bsm:category "function" ;
    bsm:atPerch bsm:BSM_0000162 ;
    bsm:functionOf bsm:BSM_0000030 .

bsm:BSM_0000172
    a owl:NamedIndividual, bsm:LawOfMotion ;
    rdfs:label "arrival law of motion"@en ;
    skos:notation "law-of-motion-arrival" ;
    skos:definition "g≺: m = R k/(𝒢ψ) + ξ, with ξ = ξ_u in the unemployment event and θ(1 − ℘ξ_u)/(1 − ℘) otherwise; from the arrival state and the shocks drawn on it to the decision state. The shocks are drawn on this transition and are not known at the arrival perch."@en ;
    bsm:category "law-of-motion" ;
    bsm:inBellmanSym "arvl_to_dcsn" .

bsm:BSM_0000173
    a owl:NamedIndividual, bsm:LawOfMotion ;
    rdfs:label "decision law of motion"@en ;
    skos:notation "law-of-motion-decision" ;
    skos:definition "g≻: a = m − c, from the decision state and the control to the continuation state."@en ;
    bsm:category "law-of-motion" ;
    bsm:inBellmanSym "dcsn_to_cntn" .

bsm:BSM_0000174
    a owl:NamedIndividual, bsm:Connector ;
    rdfs:label "connector between periods"@en ;
    skos:notation "connector" ;
    skos:definition "k′ = a: the renaming that joins one period's continuation state a to the next period's arrival state k, with no calculation; the return and the normalization by growth stand in the next period's arrival law of motion."@en ;
    bsm:category "connector" ;
    bsm:bellmanConcept "connector" .

bsm:BSM_0000175
    a owl:NamedIndividual, bsm:Operator ;
    rdfs:label "backward stage operator"@en ;
    skos:notation "backward-stage-operator" ;
    skos:definition "𝕋 = 𝕋_≺ ∘ 𝕋_≻, from continuation value to arrival value. 𝕋_≻ chooses c to maximize u(c) + β̊ V[>](m − c) over 𝒞(m), giving the decision value; 𝕋_≺ takes the expectation, V[<](k) = E[(𝒢ψ)^(1−ϱ) V(m)], whose factor (𝒢ψ)^(1−ϱ) is a non-identity arrival aggregator. 𝕋_π fixes the policy π in place of the maximization."@en ;
    bsm:category "operator" ;
    bsm:bellmanConcept "bellman_operator" .

bsm:BSM_0000176
    a owl:NamedIndividual, bsm:Operator ;
    rdfs:label "forward distribution operator"@en ;
    skos:notation "forward-distribution-operator" ;
    skos:definition "𝕄_π = 𝕄_≻,π ∘ 𝕄_≺, which moves a measure on the arrival states to the continuation states under the policy π: extending it by the shocks' laws, pushing it forward along the two laws of motion. Across the connector it gives the next period's arrival measure. Paired with the undiscounted transition expectation, it is that expectation's adjoint; the optimizing backward operator has no such pairing."@en ;
    bsm:category "operator" ;
    bsm:bellmanConcept "forward_builder" .

bsm:BSM_0000177
    a owl:NamedIndividual, bsm:Constraint ;
    rdfs:label "feasible set"@en ;
    skos:notation "feasible-set" ;
    skos:definition "𝒞(m) = (0, m − a_min], the consumption the constraint in force allows at m: a state-dependent bound, written as a feasibility correspondence. The constraint is stated three times in the families' stage files, in the set of a, in this correspondence and in the Euler equation's clause, which agree by the author's care."@en ;
    bsm:category "constraint" ;
    bsm:atPerch bsm:BSM_0000161 ;
    bsm:functionOf bsm:BSM_0000026 ;
    bsm:inBellmanSym "𝒞" .

bsm:BSM_0000062
    a owl:NamedIndividual, bsm:Moment ;
    rdfs:label "E[ψ⁻¹]"@en ;
    skos:notation "e-psi-inv" ;
    bsm:symbol "E_psi_inv" ;
    bsm:formula "E(X**-1)" ;
    bsm:momentOf bsm:BSM_0000032 ;
    bsm:inBST "\\EPermShkInv" ;
    bsm:registryKey "e-perm-shk-inv" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-gpfacmod> .

bsm:BSM_0000063
    a owl:NamedIndividual, bsm:Moment ;
    rdfs:label "E[ψ^(1−ϱ)]"@en ;
    skos:notation "e-psi-pow-1-minus-rho" ;
    bsm:symbol "E_psi_1mrho" ;
    bsm:formula "E(X**(1 - rho))" ;
    bsm:momentOf bsm:BSM_0000032 ;
    bsm:dependsOn bsm:BSM_0000037 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#fvac> .

bsm:BSM_0000064
    a owl:NamedIndividual, bsm:Moment ;
    rdfs:label "E[log ψ]"@en ;
    skos:notation "e-log-psi" ;
    bsm:symbol "E_log_psi" ;
    bsm:formula "E(log(X))" ;
    bsm:momentOf bsm:BSM_0000032 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#gicsdl> .

bsm:BSM_0000065
    a owl:NamedIndividual, bsm:Moment ;
    rdfs:label "E[ψ log ψ]"@en ;
    skos:notation "e-psi-log-psi" ;
    bsm:symbol "E_psi_log_psi" ;
    bsm:formula "E(X*log(X))" ;
    bsm:momentOf bsm:BSM_0000032 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#growth-impatience-implies-harmenberg-impatience> .

bsm:BSM_0000197
    a owl:NamedIndividual, bsm:Moment ;
    rdfs:label "E[ψ^(−ϱ)]"@en ;
    skos:notation "e-psi-pow-minus-rho" ;
    bsm:symbol "E_psi_mrho" ;
    bsm:formula "E(X**(-rho))" ;
    bsm:momentOf bsm:BSM_0000032 ;
    bsm:dependsOn bsm:BSM_0000037 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#remark-stochdiscmst> ;
    dcterms:source <https://arxiv.org/abs/1905.13045v3> .

bsm:BSM_0000066
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "discount factor with survival"@en ;
    skos:notation "discount-factor-liv" ;
    skos:definition "β̊ = β ℒ, the factor by which the household discounts next period's value when there is no annuity."@en ;
    bsm:symbol "beta_eff" ;
    bsm:formula "beta*L" ;
    bsm:dependsOn bsm:BSM_0000039 ;
    bsm:dependsOn bsm:BSM_0000038 ;
    bsm:registryKey "discount-factor-liv" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-mortality> .

bsm:BSM_0000067
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "absolute patience factor"@en ;
    skos:notation "patience-abs" ;
    skos:definition "Þ = (R β)^(1/ϱ), the growth factor of consumption under perfect foresight with infinite lives."@en ;
    bsm:symbol "thorn_raw" ;
    bsm:formula "(R*beta)**(1/rho)" ;
    bsm:dependsOn bsm:BSM_0000040 ;
    bsm:dependsOn bsm:BSM_0000038 ;
    bsm:dependsOn bsm:BSM_0000037 ;
    bsm:inBST "\\APFac" ;
    bsm:registryKey "patience-abs" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#apfac> .

bsm:BSM_0000068
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "absolute patience factor with survival"@en ;
    skos:notation "patience-abs-liv" ;
    skos:definition "Þ̊ = (R β̊)^(1/ϱ), the absolute patience factor with survival and no annuity; Þ when ℒ = 1."@en ;
    bsm:symbol "thorn" ;
    bsm:formula "(R*beta*L)**(1/rho)" ;
    bsm:dependsOn bsm:BSM_0000039 ;
    bsm:dependsOn bsm:BSM_0000040 ;
    bsm:dependsOn bsm:BSM_0000038 ;
    bsm:dependsOn bsm:BSM_0000037 ;
    bsm:registryKey "patience-abs-liv" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#apfac> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-mortality> .

bsm:BSM_0000069
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "return patience factor"@en ;
    skos:notation "patience-return-liv" ;
    skos:definition "Þ̊_R = Þ̊/R."@en ;
    bsm:symbol "thorn_R" ;
    bsm:formula "thorn/R" ;
    bsm:dependsOn bsm:BSM_0000040 ;
    bsm:dependsOn bsm:BSM_0000068 ;
    bsm:inBST "\\RPFac" ;
    bsm:registryKey "patience-return-liv" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ric> .

bsm:BSM_0000070
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "growth patience factor"@en ;
    skos:notation "patience-growth-liv" ;
    skos:definition "Þ̊_𝒢 = Þ̊/𝒢."@en ;
    bsm:symbol "thorn_G" ;
    bsm:formula "thorn/G" ;
    bsm:dependsOn bsm:BSM_0000041 ;
    bsm:dependsOn bsm:BSM_0000068 ;
    bsm:inBST "\\GPFacRaw" ;
    bsm:registryKey "patience-growth-liv" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-gpfacraw> .

bsm:BSM_0000071
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "risk-modified growth patience factor"@en ;
    skos:notation "patience-growth-mod" ;
    skos:definition "Þ̊_𝒢 E[ψ⁻¹], the expectation of the ratio of the absolute patience factor to the stochastic growth factor."@en ;
    bsm:symbol "thorn_G_mod" ;
    bsm:formula "thorn_G*E_psi_inv" ;
    bsm:dependsOn bsm:BSM_0000062 ;
    bsm:dependsOn bsm:BSM_0000070 ;
    bsm:inBST "\\GPFacMod" ;
    bsm:registryKey "patience-growth-mod" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-gpfacmod> .

bsm:BSM_0000072
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "mortality-adjusted growth patience factor"@en ;
    skos:notation "patience-growth-mortality-adj" ;
    skos:definition "ℒ Þ̊_𝒢, the growth patience factor of a cohort whose members die at rate 1 − ℒ."@en ;
    bsm:symbol "thorn_G_liv" ;
    bsm:formula "L*thorn_G" ;
    bsm:dependsOn bsm:BSM_0000039 ;
    bsm:dependsOn bsm:BSM_0000070 ;
    bsm:registryKey "patience-growth-mortality-adj" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#giclivmoddefn> .

bsm:BSM_0000073
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "return factor normalized by growth"@en ;
    skos:notation "return-growth-ratio" ;
    skos:definition "ℛ = R/𝒢."@en ;
    bsm:symbol "R_by_G" ;
    bsm:formula "R/G" ;
    bsm:dependsOn bsm:BSM_0000041 ;
    bsm:dependsOn bsm:BSM_0000040 ;
    bsm:inBST "\\RNrmByG" ;
    bsm:registryKey "return-growth-ratio" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-veqnnrmrecbellman> .

bsm:BSM_0000074
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "finite human wealth factor"@en ;
    skos:notation "human-wealth-factor" ;
    skos:definition "𝒢/R, the factor by which the present value of noncapital income is discounted each period."@en ;
    bsm:symbol "fhw" ;
    bsm:formula "G/R" ;
    bsm:dependsOn bsm:BSM_0000041 ;
    bsm:dependsOn bsm:BSM_0000040 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-fhwc> .

bsm:BSM_0000075
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "human wealth"@en ;
    skos:notation "human-wealth" ;
    skos:definition "h, the present value of noncapital income as a ratio to permanent income, including this period's, in the limit of an infinite horizon; finite exactly when the FHWC holds."@en ;
    bsm:symbol "h" ;
    bsm:formula "1/(1 - G/R)" ;
    bsm:domain bsm:BSM_0000085 ;
    bsm:dependsOn bsm:BSM_0000041 ;
    bsm:dependsOn bsm:BSM_0000040 ;
    bsm:inBST "\\hNrm" ;
    bsm:registryKey "human-wealth" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-hdef> .

bsm:BSM_0000076
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "perfect-foresight value-of-autarky factor"@en ;
    skos:notation "value-of-autarky-factor-pf" ;
    skos:definition "β̊ 𝒢^(1−ϱ), the factor of the value of consuming permanent income forever under perfect foresight."@en ;
    bsm:symbol "vaf_pf" ;
    bsm:formula "beta*L*G**(1 - rho)" ;
    bsm:dependsOn bsm:BSM_0000041 ;
    bsm:dependsOn bsm:BSM_0000039 ;
    bsm:dependsOn bsm:BSM_0000038 ;
    bsm:dependsOn bsm:BSM_0000037 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pffvac> .

bsm:BSM_0000077
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "value-of-autarky factor"@en ;
    skos:notation "value-of-autarky-factor" ;
    skos:definition "β̊ 𝒢^(1−ϱ) E[ψ^(1−ϱ)], the factor of the value of consuming permanent income forever."@en ;
    bsm:symbol "vaf" ;
    bsm:formula "beta*L*G**(1 - rho)*E_psi_1mrho" ;
    bsm:dependsOn bsm:BSM_0000063 ;
    bsm:dependsOn bsm:BSM_0000041 ;
    bsm:dependsOn bsm:BSM_0000039 ;
    bsm:dependsOn bsm:BSM_0000038 ;
    bsm:dependsOn bsm:BSM_0000037 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#fvac> .

bsm:BSM_0000078
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "weak return patience factor"@en ;
    skos:notation "weak-return-patience-factor" ;
    skos:definition "p_worst^(1/ϱ) Þ̊_R, the return patience factor scaled by the probability of the worst income."@en ;
    bsm:symbol "wrp" ;
    bsm:formula "p_worst**(1/rho)*thorn_R" ;
    bsm:dependsOn bsm:BSM_0000049 ;
    bsm:dependsOn bsm:BSM_0000037 ;
    bsm:dependsOn bsm:BSM_0000069 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#wric> .

bsm:BSM_0000079
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "limiting MPC as resources grow"@en ;
    skos:notation "mpc-min" ;
    skos:definition "κ_min = max(0, 1 − Þ̊_R), the limit of the MPC as m → ∞."@en ;
    bsm:symbol "mpc_min" ;
    bsm:formula "max([0, 1 - thorn_R])" ;
    bsm:dependsOn bsm:BSM_0000069 ;
    bsm:inBST "\\MPCmin" ;
    bsm:registryKey "mpc-min" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#mpcmindefn> .

bsm:BSM_0000080
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "limiting MPC as resources fall to their lowest"@en ;
    skos:notation "mpc-max" ;
    skos:definition "κ_max = 1 − p_worst^(1/ϱ) Þ̊_R, the limit of the MPC as m falls to its lowest value."@en ;
    bsm:symbol "mpc_max" ;
    bsm:formula "1 - p_worst**(1/rho)*thorn_R" ;
    bsm:dependsOn bsm:BSM_0000049 ;
    bsm:dependsOn bsm:BSM_0000037 ;
    bsm:dependsOn bsm:BSM_0000069 ;
    bsm:inBST "\\MPCmax" ;
    bsm:registryKey "mpc-max" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-mpcmaxdefn> .

bsm:BSM_0000081
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "natural borrowing limit, computed"@en ;
    skos:notation "natural-limit" ;
    skos:definition "The value of a_Nat: −ξ_min ψ_min/(ℛ − ψ_min), which is zero when the worst transitory income is zero or the permanent shock's law is unbounded below."@en ;
    bsm:symbol "a_Nat_value" ;
    bsm:formula "-xi_min*psi_min/(R/G - psi_min)" ;
    bsm:note "when ψ_min < ℛ; otherwise there is no natural limit" ;
    bsm:dependsOn bsm:BSM_0000041 ;
    bsm:dependsOn bsm:BSM_0000040 ;
    bsm:dependsOn bsm:BSM_0000046 ;
    bsm:dependsOn bsm:BSM_0000047 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#borocnstnat> .

bsm:BSM_0000198
    a owl:NamedIndividual, bsm:Quantity ;
    rdfs:label "discounted return factor of the normalized problem"@en ;
    skos:notation "discounted-return-factor" ;
    skos:definition "Ma, Stachurski and Toda's G_βR, the long-run mean of the discount factor times the return, for the normalized problem. Its discount factor is β̊(𝒢ψ′)^(1−ϱ) and its return R/(𝒢ψ′), so with iid shocks G_βR is the mean of their product, β̊ R 𝒢^(−ϱ) E[ψ^(−ϱ)] = E[(Þ̊_𝒢/ψ)^ϱ]. Without permanent shocks it is Þ̊_𝒢^ϱ."@en ;
    bsm:symbol "g_beta_R" ;
    bsm:formula "beta*L*R*G**(-rho)*E_psi_mrho" ;
    bsm:dependsOn bsm:BSM_0000197 ;
    bsm:dependsOn bsm:BSM_0000041 ;
    bsm:dependsOn bsm:BSM_0000039 ;
    bsm:dependsOn bsm:BSM_0000040 ;
    bsm:dependsOn bsm:BSM_0000038 ;
    bsm:dependsOn bsm:BSM_0000037 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#remark-stochdiscmst> ;
    dcterms:source <https://arxiv.org/abs/1905.13045v3> .

bsm:BSM_0000082
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "absolute impatience"@en ;
    skos:notation "aic" ;
    bsm:holdsWhen "thorn < 1" ;
    bsm:shortName "AIC" ;
    bsm:hasFactor bsm:BSM_0000068 ;
    bsm:dependsOn bsm:BSM_0000068 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#aic> .

bsm:BSM_0000083
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "return impatience"@en ;
    skos:notation "ric" ;
    bsm:holdsWhen "thorn_R < 1" ;
    bsm:shortName "RIC" ;
    bsm:hasFactor bsm:BSM_0000069 ;
    bsm:dependsOn bsm:BSM_0000069 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ric> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-ric> .

bsm:BSM_0000084
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "weak return impatience"@en ;
    skos:notation "wric" ;
    bsm:holdsWhen "wrp < 1" ;
    bsm:shortName "WRIC" ;
    bsm:hasFactor bsm:BSM_0000078 ;
    bsm:dependsOn bsm:BSM_0000078 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#wric> .

bsm:BSM_0000085
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "finite human wealth"@en ;
    skos:notation "fhwc" ;
    bsm:holdsWhen "fhw < 1" ;
    bsm:shortName "FHWC" ;
    bsm:hasFactor bsm:BSM_0000074 ;
    bsm:dependsOn bsm:BSM_0000074 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ass-fhwc> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-fhwc2> .

bsm:BSM_0000086
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "perfect-foresight finite value of autarky"@en ;
    skos:notation "fvac-pf" ;
    skos:note "A modified condition's signifier follows its base name, as in GIC-Mod and GIC-Liv. BST writes \\PFFVAC, and the schemas' checker PF-FVAC."@en ;
    bsm:holdsWhen "vaf_pf < 1" ;
    bsm:shortName "FVAC-PF" ;
    bsm:hasFactor bsm:BSM_0000076 ;
    bsm:dependsOn bsm:BSM_0000076 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pffvac> .

bsm:BSM_0000087
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "finite value of autarky"@en ;
    skos:notation "fvac" ;
    bsm:holdsWhen "vaf < 1" ;
    bsm:shortName "FVAC" ;
    bsm:hasFactor bsm:BSM_0000077 ;
    bsm:dependsOn bsm:BSM_0000077 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#fvac> .

bsm:BSM_0000088
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "growth impatience"@en ;
    skos:notation "gic" ;
    bsm:holdsWhen "thorn_G < 1" ;
    bsm:shortName "GIC" ;
    bsm:hasFactor bsm:BSM_0000070 ;
    bsm:dependsOn bsm:BSM_0000070 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#gicraw> .

bsm:BSM_0000089
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "strong growth impatience"@en ;
    skos:notation "gic-mod" ;
    bsm:holdsWhen "thorn_G_mod < 1" ;
    bsm:shortName "GIC-Mod" ;
    bsm:hasFactor bsm:BSM_0000071 ;
    bsm:dependsOn bsm:BSM_0000071 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#gicmod> .

bsm:BSM_0000090
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "log growth impatience"@en ;
    skos:notation "gic-szeidl" ;
    bsm:holdsWhen "log(thorn_G) < E_log_psi" ;
    bsm:shortName "GIC-Szeidl" ;
    bsm:hasFactor bsm:BSM_0000070 ;
    bsm:dependsOn bsm:BSM_0000064 ;
    bsm:dependsOn bsm:BSM_0000070 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#gicsdl> .

bsm:BSM_0000091
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "Harmenberg growth impatience"@en ;
    skos:notation "gic-harmenberg" ;
    bsm:holdsWhen "thorn_G < exp(E_psi_log_psi)" ;
    bsm:shortName "GIC-Harmenberg" ;
    bsm:hasFactor bsm:BSM_0000070 ;
    bsm:dependsOn bsm:BSM_0000065 ;
    bsm:dependsOn bsm:BSM_0000070 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#growth-impatience-implies-harmenberg-impatience> .

bsm:BSM_0000092
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "mortality-adjusted growth impatience"@en ;
    skos:notation "gic-liv" ;
    skos:note "The paper writes ℒ Þ_𝒢 < 1 without saying whether Þ carries survival. econ-ark's notation registry fixes the condition as ℒ Þ̊_𝒢 < 1: a survivor discounts by βℒ, so its wealth grows at Þ̊, and the cohort shrinks at ℒ. It assumes, as the paper does, that newborns' permanent income grows with aggregate productivity."@en ;
    bsm:holdsWhen "thorn_G_liv < 1" ;
    bsm:shortName "GIC-Liv" ;
    bsm:hasFactor bsm:BSM_0000072 ;
    bsm:dependsOn bsm:BSM_0000072 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#giclivmoddefn> .

bsm:BSM_0000199
    a owl:NamedIndividual, bsm:Condition ;
    rdfs:label "the discounted-return condition of Ma, Stachurski and Toda"@en ;
    skos:notation "discounted-return" ;
    skos:note "Their generalization of the condition βR < 1 to random discounting and returns, which the normalized problem has. It bounds the ϱ-th moment of Þ̊_𝒢/ψ, where the GIC-Mod bounds its mean."@en ;
    bsm:holdsWhen "g_beta_R < 1" ;
    bsm:shortName "MST-βR" ;
    bsm:hasFactor bsm:BSM_0000198 ;
    bsm:dependsOn bsm:BSM_0000198 ;
    dcterms:source <https://arxiv.org/abs/1905.13045v3> .

bsm:BSM_0000093
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "a non-degenerate limiting solution"@en ;
    skos:notation "nondegenerate-limiting-solution" ;
    skos:definition "The finite-horizon consumption and value functions converge, as the horizon recedes, to a consumption function that is positive and finite for every m > 0 and a real-valued value function."@en ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#def-nondegeneracy> .

bsm:BSM_0000094
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "consumption growth below one as resources grow"@en ;
    skos:notation "consumption-falls-at-high-wealth" ;
    skos:definition "As m → ∞, the growth factor of consumption approaches the absolute patience factor, which is below one."@en ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#aic> .

bsm:BSM_0000095
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "a positive MPC as resources grow"@en ;
    skos:notation "positive-limiting-mpc" ;
    skos:definition "The MPC of the limiting consumption function tends to 1 − Þ̊_R > 0 as m → ∞."@en ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#lemma-mpcboundsconvg> .

bsm:BSM_0000096
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "finite human wealth"@en ;
    skos:notation "finite-human-wealth" ;
    skos:definition "The present value of noncapital income is finite in the limit of an infinite horizon."@en ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-hdef> .

bsm:BSM_0000097
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "an individual buffer-stock target"@en ;
    skos:notation "target-exists" ;
    skos:definition "There is a unique m̂ > 0 with E_t[m_{t+1}] = m_t at m_t = m̂, below which expected m rises and above which it falls."@en ;
    bsm:symbol "m̂" ;
    bsm:inBST "\\mTrgNrm" ;
    bsm:registryKey "target" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#thm-target> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-mtarget> .

bsm:BSM_0000098
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "a pseudo-target"@en ;
    skos:notation "pseudo-target-exists" ;
    skos:definition "There is a unique m̌ > 0 at which the expected growth factor of the level of market resources equals 𝒢, below which it is higher and above which it is lower."@en ;
    bsm:symbol "m̌" ;
    bsm:inBST "\\mBalLvl" ;
    bsm:registryKey "pseudo-target" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#thm-mssbalexists> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-mballvl> .

bsm:BSM_0000099
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "a log target"@en ;
    skos:notation "log-target-exists" ;
    skos:definition "There is an m̃ at which E_t[log 𝐦_{t+1}] = log 𝒢 𝐦_t; the paper states its existence under log growth impatience in a footnote, without proof."@en ;
    bsm:symbol "m̃" ;
    bsm:inBST "\\mBalLog" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#collective-stability> .

bsm:BSM_0000100
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "an invariant distribution under the population measure"@en ;
    skos:notation "invariant-population-distribution" ;
    skos:definition "A population following the limiting rule has invariant distributions of m, c and a, each agent weighted equally."@en ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#gicsdl> .

bsm:BSM_0000101
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "an invariant distribution under the income measure"@en ;
    skos:notation "invariant-income-distribution" ;
    skos:definition "A population following the limiting rule has invariant distributions of m and c weighted by permanent income."@en ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#growth-rates-of-aggregate-income-and-consumption> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-harmcdf> .

bsm:BSM_0000102
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "aggregate balanced growth"@en ;
    skos:notation "aggregate-balanced-growth" ;
    skos:definition "Aggregate consumption, market resources and assets grow in the long run at the growth factor of aggregate permanent income."@en ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#growth-rates-of-aggregate-income-and-consumption> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsec-cgroeqpermgrofacq> .

bsm:BSM_0000103
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "the artificial constraint is relevant"@en ;
    skos:notation "constraint-relevant" ;
    skos:definition "Under perfect foresight, a constraint a ≥ 0 binds at some m."@en ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-liqconstrbinds> .

bsm:BSM_0000104
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "buffer-stock saving"@en ;
    skos:notation "buffer-stock-saving" ;
    skos:definition "A member exhibits buffer-stock saving when it has a non-degenerate limiting solution and an individual buffer-stock target. This draft takes the individual target, as the paper's introduction does; whether the pseudo-target suffices is left open."@en ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-intro> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#patience-requirements-and-the-existence-of-buffer-stock-targets> .

bsm:BSM_0000182
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "the constraint in force binds"@en ;
    skos:notation "constraint-binds" ;
    skos:definition "On an interval of m just above the lowest feasible resources, the agent ends the period at the constraint: c = m − a_min, and the MPC is one."@en ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsubsec-deatonislimit> .

bsm:BSM_0000183
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "the constrained rule is the unconstrained one"@en ;
    skos:notation "constrained-equals-unconstrained" ;
    skos:definition "Under perfect foresight, the constrained consumption function equals the unconstrained one for every m ≥ 1."@en ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#table-liqconstrscenarios> .

bsm:BSM_0000184
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "the constrained rule approaches the unconstrained one"@en ;
    skos:notation "constrained-approaches-unconstrained" ;
    skos:definition "Under perfect foresight, the unconstrained consumption function minus the constrained one tends to zero as m → ∞."@en ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#table-liqconstrscenarios> .

bsm:BSM_0000185
    a owl:NamedIndividual, bsm:Property ;
    rdfs:label "an MPC that vanishes as resources grow"@en ;
    skos:notation "zero-limiting-mpc" ;
    skos:definition "The MPC of the limiting consumption function tends to zero as m → ∞."@en ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#table-liqconstrscenarios> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsubsec-whenthericfails> .

bsm:BSM_0000105
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "existence of a non-degenerate solution"@en ;
    skos:notation "existence" ;
    bsm:status "bst" ;
    bsm:resultKind "theorem" ;
    bsm:within bsm:BSM_0000002 ;
    bsm:assumes bsm:BSM_0000084 ;
    bsm:assumes bsm:BSM_0000087 ;
    bsm:concludes bsm:BSM_0000093 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sufficient-conditions-for-non-degenerate-solution> .

bsm:BSM_0000106
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "contraction under consumption bounds"@en ;
    skos:notation "contraction" ;
    skos:note "The MPC-bounded Bellman operator is eventually a contraction on a weighted-norm space."@en ;
    bsm:status "bst" ;
    bsm:resultKind "theorem" ;
    bsm:within bsm:BSM_0000002 ;
    bsm:assumes bsm:BSM_0000084 ;
    bsm:assumes bsm:BSM_0000087 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#thm-cmap> .

bsm:BSM_0000107
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the limiting MPCs"@en ;
    skos:notation "limiting-mpcs" ;
    skos:note "The maximal MPC converges to κ_max > 0; under the RIC the minimal MPC converges to 1 − Þ_R > 0."@en ;
    bsm:status "bst" ;
    bsm:resultKind "lemma" ;
    bsm:within bsm:BSM_0000002 ;
    bsm:assumes bsm:BSM_0000084 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#limiting-mpcs> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#cfuncbounds> .

bsm:BSM_0000108
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the limiting rule's MPC bounds"@en ;
    skos:notation "mpc-bounds-of-the-limit" ;
    bsm:status "bst" ;
    bsm:resultKind "lemma" ;
    bsm:within bsm:BSM_0000002 ;
    bsm:assumes bsm:BSM_0000084 ;
    bsm:assumes bsm:BSM_0000083 ;
    bsm:concludes bsm:BSM_0000095 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#lemma-mpcboundsconvg> .

bsm:BSM_0000109
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the buffer-stock target"@en ;
    skos:notation "target" ;
    bsm:status "bst" ;
    bsm:resultKind "theorem" ;
    bsm:within bsm:BSM_0000002 ;
    bsm:assumes bsm:BSM_0000084 ;
    bsm:assumes bsm:BSM_0000087 ;
    bsm:assumes bsm:BSM_0000089 ;
    bsm:concludes bsm:BSM_0000097 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#thm-target> .

bsm:BSM_0000110
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the pseudo-target"@en ;
    skos:notation "pseudo-target" ;
    bsm:status "bst" ;
    bsm:resultKind "theorem" ;
    bsm:within bsm:BSM_0000002 ;
    bsm:assumes bsm:BSM_0000084 ;
    bsm:assumes bsm:BSM_0000087 ;
    bsm:assumes bsm:BSM_0000088 ;
    bsm:concludes bsm:BSM_0000098 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#thm-mssbalexists> .

bsm:BSM_0000111
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the log target"@en ;
    skos:notation "log-target" ;
    skos:note "Stated in a footnote, without proof; the three points are ordered m̌ < m̃ < m̂ where they exist."@en ;
    bsm:status "stated" ;
    bsm:resultKind "remark" ;
    bsm:within bsm:BSM_0000002 ;
    bsm:assumes bsm:BSM_0000090 ;
    bsm:concludes bsm:BSM_0000099 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#collective-stability> .

bsm:BSM_0000112
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "Szeidl's invariance theorem"@en ;
    skos:notation "szeidl" ;
    bsm:status "cited" ;
    bsm:resultKind "theorem" ;
    bsm:within bsm:BSM_0000002 ;
    bsm:assumes bsm:BSM_0000090 ;
    bsm:concludes bsm:BSM_0000100 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#gicsdl> .

bsm:BSM_0000113
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "Harmenberg's invariance theorem"@en ;
    skos:notation "harmenberg" ;
    bsm:status "cited" ;
    bsm:resultKind "theorem" ;
    bsm:within bsm:BSM_0000002 ;
    bsm:assumes bsm:BSM_0000088 ;
    bsm:concludes bsm:BSM_0000101 ;
    bsm:concludes bsm:BSM_0000102 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#growth-rates-of-aggregate-income-and-consumption> .

bsm:BSM_0000114
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "balanced growth with estates destroyed"@en ;
    skos:notation "mortality-balanced-growth" ;
    bsm:status "bst" ;
    bsm:resultKind "remark" ;
    bsm:within bsm:BSM_0000004 ;
    bsm:assumes bsm:BSM_0000092 ;
    bsm:concludes bsm:BSM_0000102 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#giclivmoddefn> .

bsm:BSM_0000115
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the unconstrained perfect-foresight solution"@en ;
    skos:notation "pf-unconstrained" ;
    skos:note "If and only if."@en ;
    bsm:status "bst" ;
    bsm:resultKind "proposition" ;
    bsm:within bsm:BSM_0000003 ;
    bsm:assumes bsm:BSM_0000085 ;
    bsm:assumes bsm:BSM_0000083 ;
    bsm:concludes bsm:BSM_0000093 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#prop-pfucfhwc> .

bsm:BSM_0000116
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the constrained perfect-foresight solution"@en ;
    skos:notation "pf-constrained" ;
    skos:note "When the RIC fails, a non-degenerate solution exists if and only if the GIC holds: pf-constrained-without-ric and pf-constrained-degenerate."@en ;
    bsm:status "bst" ;
    bsm:resultKind "proposition" ;
    bsm:within bsm:BSM_0000180 ;
    bsm:assumes bsm:BSM_0000083 ;
    bsm:concludes bsm:BSM_0000093 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#prop-pfcexist> .

bsm:BSM_0000117
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "when the constraint binds under perfect foresight"@en ;
    skos:notation "pf-constraint-relevance" ;
    skos:note "If and only if; pf-constraint-slack states the converse."@en ;
    bsm:status "bst" ;
    bsm:resultKind "remark" ;
    bsm:within bsm:BSM_0000180 ;
    bsm:assumes bsm:BSM_0000088 ;
    bsm:concludes bsm:BSM_0000103 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-liqconstrbinds> .

bsm:BSM_0000118
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the constrained solution as a limit"@en ;
    skos:notation "liquidity-constrained-limit" ;
    skos:note "As ℘ ↓ 0, each finite-horizon consumption function c_t(m; ℘) converges to that of the liquidity-constrained problem: ℘ = 0, a positive minimum income and the constraint a ≥ 0, a member of the liquidity-constrained class. With ℘ > 0 the same constraint changes nothing (loose-artificial-constraint)."@en ;
    bsm:status "bst" ;
    bsm:resultKind "theorem" ;
    bsm:within bsm:BSM_0000002 ;
    bsm:limitIn bsm:BSM_0000200 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsubsec-deatonislimit> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-liqconstraslimit> .

bsm:BSM_0000119
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "return and growth patience together rule out a finite value of autarky"@en ;
    skos:notation "no-ric-no-gic" ;
    bsm:status "bst" ;
    bsm:resultKind "property" ;
    bsm:assumesFailureOf bsm:BSM_0000083 ;
    bsm:assumesFailureOf bsm:BSM_0000088 ;
    bsm:concludesFailureOf bsm:BSM_0000087 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#vafacdefn> .

bsm:BSM_0000120
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "growth impatience and finite human wealth give the perfect-foresight finite value of autarky"@en ;
    skos:notation "gic-implies-fvac-pf" ;
    bsm:status "bst" ;
    bsm:resultKind "property" ;
    bsm:assumes bsm:BSM_0000085 ;
    bsm:assumes bsm:BSM_0000088 ;
    bsm:concludes bsm:BSM_0000086 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#claim-pfconspc> .

bsm:BSM_0000121
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the perfect-foresight finite value of autarky and finite human wealth give return impatience"@en ;
    skos:notation "fvac-pf-implies-ric" ;
    bsm:status "bst" ;
    bsm:resultKind "property" ;
    bsm:assumes bsm:BSM_0000085 ;
    bsm:assumes bsm:BSM_0000086 ;
    bsm:concludes bsm:BSM_0000083 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#claim-pfconspc> .

bsm:BSM_0000122
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "growth impatience without return impatience means infinite human wealth"@en ;
    skos:notation "gic-without-ric" ;
    bsm:status "bst" ;
    bsm:resultKind "remark" ;
    bsm:assumes bsm:BSM_0000088 ;
    bsm:assumesFailureOf bsm:BSM_0000083 ;
    bsm:concludesFailureOf bsm:BSM_0000085 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#prop-pfcexist> .

bsm:BSM_0000123
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the finite value of autarky implies its perfect-foresight version"@en ;
    skos:notation "fvac-implies-fvac-pf" ;
    skos:note "Jensen's inequality, with ϱ > 1 and E[ψ] = 1, gives E[ψ^(1−ϱ)] ≥ 1."@en ;
    bsm:status "deduced" ;
    bsm:resultKind "remark" ;
    bsm:assumes bsm:BSM_0000087 ;
    bsm:concludes bsm:BSM_0000086 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#vafacdefn> .

bsm:BSM_0000124
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "return impatience implies weak return impatience"@en ;
    skos:notation "ric-implies-wric" ;
    bsm:status "bst" ;
    bsm:resultKind "remark" ;
    bsm:assumes bsm:BSM_0000083 ;
    bsm:concludes bsm:BSM_0000084 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#wric> .

bsm:BSM_0000125
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "strong growth impatience implies log growth impatience"@en ;
    skos:notation "gic-mod-implies-gic-szeidl" ;
    bsm:status "bst" ;
    bsm:resultKind "remark" ;
    bsm:assumes bsm:BSM_0000089 ;
    bsm:concludes bsm:BSM_0000090 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#gicsdl> .

bsm:BSM_0000126
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "log growth impatience implies growth impatience"@en ;
    skos:notation "gic-szeidl-implies-gic" ;
    bsm:status "bst" ;
    bsm:resultKind "remark" ;
    bsm:assumes bsm:BSM_0000090 ;
    bsm:concludes bsm:BSM_0000088 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#gicsdl> .

bsm:BSM_0000127
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "growth impatience implies Harmenberg's condition"@en ;
    skos:notation "gic-implies-gic-harmenberg" ;
    bsm:status "bst" ;
    bsm:resultKind "property" ;
    bsm:assumes bsm:BSM_0000088 ;
    bsm:concludes bsm:BSM_0000091 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#growth-impatience-implies-harmenberg-impatience> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#claim-gicimpliesharmimp> .

bsm:BSM_0000128
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "growth impatience implies its mortality-adjusted version"@en ;
    skos:notation "gic-implies-gic-liv" ;
    skos:note "The mortality-adjusted condition is looser, since ℒ ≤ 1."@en ;
    bsm:status "bst" ;
    bsm:resultKind "remark" ;
    bsm:assumes bsm:BSM_0000088 ;
    bsm:concludes bsm:BSM_0000092 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#giclivmoddefn> .

bsm:BSM_0000153
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "with a finite value of autarky, return patience means infinite human wealth"@en ;
    skos:notation "fvac-without-ric" ;
    skos:note "From no-ric-no-gic, the FVAC with the RIC failing gives the GIC; from gic-without-ric, the GIC with the RIC failing gives infinite human wealth. Uses ϱ > 1."@en ;
    bsm:status "deduced" ;
    bsm:resultKind "remark" ;
    bsm:assumes bsm:BSM_0000087 ;
    bsm:assumesFailureOf bsm:BSM_0000083 ;
    bsm:concludesFailureOf bsm:BSM_0000085 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#vafacdefn> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#prop-pfcexist> .

bsm:BSM_0000190
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "return impatience without growth impatience means finite human wealth"@en ;
    skos:notation "ric-without-gic" ;
    skos:note "𝒢 ≤ Þ̊ < R. The paper's table states it for the constrained perfect-foresight model; it holds of the conditions alone."@en ;
    bsm:status "bst" ;
    bsm:resultKind "remark" ;
    bsm:assumes bsm:BSM_0000083 ;
    bsm:assumesFailureOf bsm:BSM_0000088 ;
    bsm:concludes bsm:BSM_0000085 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#table-liqconstrscenarios> .

bsm:BSM_0000186
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the constrained perfect-foresight solution when return impatience fails"@en ;
    skos:notation "pf-constrained-without-ric" ;
    skos:note "Human wealth is then infinite (gic-without-ric), yet the constraint prevents borrowing against it at every finite horizon, and the MPC tends to zero as m grows."@en ;
    bsm:status "bst" ;
    bsm:resultKind "proposition" ;
    bsm:within bsm:BSM_0000180 ;
    bsm:assumesFailureOf bsm:BSM_0000083 ;
    bsm:assumes bsm:BSM_0000088 ;
    bsm:concludes bsm:BSM_0000093 ;
    bsm:concludes bsm:BSM_0000185 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#prop-pfcexist> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#table-liqconstrscenarios> .

bsm:BSM_0000187
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "without return or growth impatience the constrained solution is degenerate"@en ;
    skos:notation "pf-constrained-degenerate" ;
    skos:note "The finite value of autarky then fails (no-ric-no-gic), so the value clause of non-degeneracy cannot hold; the limiting consumption function is zero."@en ;
    bsm:status "bst" ;
    bsm:resultKind "proposition" ;
    bsm:within bsm:BSM_0000180 ;
    bsm:assumesFailureOf bsm:BSM_0000083 ;
    bsm:assumesFailureOf bsm:BSM_0000088 ;
    bsm:concludesFailureOf bsm:BSM_0000093 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#prop-pfcexist> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#table-liqconstrscenarios> .

bsm:BSM_0000188
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "without growth impatience the constraint never binds"@en ;
    skos:notation "pf-constraint-slack" ;
    skos:note "Human wealth is then finite (ric-without-gic)."@en ;
    bsm:status "bst" ;
    bsm:resultKind "remark" ;
    bsm:within bsm:BSM_0000180 ;
    bsm:assumes bsm:BSM_0000083 ;
    bsm:assumesFailureOf bsm:BSM_0000088 ;
    bsm:concludesFailureOf bsm:BSM_0000103 ;
    bsm:concludes bsm:BSM_0000183 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-liqconstrbinds> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#table-liqconstrscenarios> .

bsm:BSM_0000189
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "with both impatience conditions the constrained rule converges to the unconstrained one"@en ;
    skos:notation "pf-constrained-converges" ;
    skos:note "The constraint binds in finite time from every m; finite human wealth may hold or fail."@en ;
    bsm:status "bst" ;
    bsm:resultKind "remark" ;
    bsm:within bsm:BSM_0000180 ;
    bsm:assumes bsm:BSM_0000083 ;
    bsm:assumes bsm:BSM_0000088 ;
    bsm:concludes bsm:BSM_0000103 ;
    bsm:concludes bsm:BSM_0000184 ;
    bsm:concludes bsm:BSM_0000095 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#table-liqconstrscenarios> .

bsm:BSM_0000191
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "an MPC that vanishes when return impatience fails"@en ;
    skos:notation "zero-mpc-without-ric" ;
    skos:note "Human wealth is then infinite (fvac-without-ric). The natural constraint plays the part the artificial one plays under perfect foresight (pf-constrained-without-ric): it prevents infinite borrowing, while infinite human wealth keeps patience from driving consumption to zero."@en ;
    bsm:status "bst" ;
    bsm:resultKind "remark" ;
    bsm:within bsm:BSM_0000002 ;
    bsm:assumes bsm:BSM_0000084 ;
    bsm:assumes bsm:BSM_0000087 ;
    bsm:assumesFailureOf bsm:BSM_0000083 ;
    bsm:concludes bsm:BSM_0000185 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsubsec-whenthericfails> .

bsm:BSM_0000192
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the natural constraint never binds"@en ;
    skos:notation "natural-constraint-never-binds" ;
    skos:note "The zero-income event, which leaves income at zero whatever ψ, already keeps the consumer from ending a period at the natural limit, since zero income thereafter would leave no positive consumption. An artificial constraint at that limit therefore changes nothing (loose-artificial-constraint). Near the lowest resources the MPC approaches κ_max, which is below one (limiting-mpcs)."@en ;
    bsm:status "stated" ;
    bsm:resultKind "remark" ;
    bsm:within bsm:BSM_0000210 ;
    bsm:concludesFailureOf bsm:BSM_0000182 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsubsec-deatonislimit> .

bsm:BSM_0000193
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "an artificial constraint binds"@en ;
    skos:notation "artificial-constraint-binds" ;
    skos:note "With a_Nat < a_Art ≤ 0, the lowest resources next period, R a_Art/(𝒢ψ_min) + ξ_min, lie strictly above a_Art, so consumption next period is bounded away from zero and the expected marginal value of ending the period at a_Art is finite. As m falls toward a_Art, u′(m − a_Art) grows without bound, so the Euler equation holds with the constraint binding. This holds in every finite-horizon solution, and in the limit where it exists. It is not tested: the tests check implications among the conditions, not properties of solutions. A positive a_Art, a floor on saving rather than a limit on borrowing, is not considered."@en ;
    bsm:status "deduced" ;
    bsm:resultKind "remark" ;
    bsm:within bsm:BSM_0000007 ;
    bsm:concludes bsm:BSM_0000182 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsubsec-deatonislimit> .

bsm:BSM_0000194
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "weak return impatience cannot be relaxed without an artificial constraint"@en ;
    skos:notation "wric-without-artificial-constraint" ;
    skos:note "The paper says weak return impatience \"cannot be relaxed further without an artificial liquidity constraint\", and that the condition does not become irrelevant as ℘ → 0. Read here as necessity within the paper's class. The paper gives no proof. The ontology treats the claim as true until the paper proves it, and the paper's own tracker asks for that proof. A route through results the paper already has: each finite-horizon c_t is concave with c_t(0) = 0 and slope κ̄_t at zero, so c_t(m) ≤ κ̄_t m; the recursion κ̄_t⁻¹ = 1 + ℘^(1/ϱ) Þ_R κ̄_{t+1}⁻¹ needs no WRIC; and when the WRIC fails, κ̄_{T−n} ≤ 1/(n+1), so c_{T−n} → 0."@en ;
    bsm:status "stated" ;
    bsm:resultKind "remark" ;
    bsm:within bsm:BSM_0000002 ;
    bsm:assumesFailureOf bsm:BSM_0000084 ;
    bsm:concludesFailureOf bsm:BSM_0000093 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#wric> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#limiting-mpcs> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#prop-cfuncprop> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#cfuncbounds> .

bsm:BSM_0000195
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the constrained problem as a case of Ma, Stachurski and Toda"@en ;
    skos:notation "mst-special-case" ;
    skos:note "With ℘ = 0, the normalized problem is a special case of Ma, Stachurski and Toda (2020), with R/(𝒢ψ′) as the stochastic return and β(𝒢ψ′)^(1−ϱ) as the stochastic discount factor. Their Assumption 2.1 generalizes the finite value of autarky, in a setting with an artificial constraint. Their assumptions are stated in the ontology's terms in mst-existence and mst-stationary-distribution. Their model gives the discount factor, the return and income separate innovations, while in the normalized problem the discount factor and the return share ψ′. That fits their statement exactly when ψ has finite support, by taking ψ as their Markov state. For a continuous law of ψ it rests on their proofs not needing the separation, which has not been checked."@en ;
    bsm:status "cited" ;
    bsm:resultKind "remark" ;
    bsm:within bsm:BSM_0000200 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#remark-stochdiscmst> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#cite-mstincfluct> ;
    dcterms:source <https://arxiv.org/abs/1905.13045v3> .

bsm:BSM_0000196
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "what an artificial constraint does for the proof of existence"@en ;
    skos:notation "compact-feasible-set" ;
    skos:note "With an artificial constraint, the continuation value is real even at c = m, and the value function is bounded below as a function of end-of-period assets, so the Bellman operator can be defined on a compact feasible set, [0, m] for the constraint a ≥ 0 (Ma, Stachurski and Toda, 2022). Under the natural constraint, the feasible set (0, m) is not compact and Berge's maximum theorem does not apply, so the paper proves existence another way (contraction)."@en ;
    bsm:status "cited" ;
    bsm:resultKind "remark" ;
    bsm:within bsm:BSM_0000007 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsubsec-challengesdp> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#remark-notcompact> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#cite-ma2022> ;
    dcterms:source <https://arxiv.org/abs/2012.00219v2> .

bsm:BSM_0000202
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "existence in the liquidity-constrained model"@en ;
    skos:notation "mst-existence" ;
    skos:note "Ma, Stachurski and Toda's Theorem 2.2, read in the ontology's terms (mst-special-case). Their Assumption 2.1, G_β < 1, is then the FVAC: G_β = β̊ 𝒢^(1−ϱ) E[ψ^(1−ϱ)], as the paper notes. Their Assumption 2.2 is the discounted-return condition. Their Assumption 2.3, E[ξ] < ∞ and E[ξ^(−ϱ)] < ∞, holds in the class, whose lowest income is positive; with a zero-income event it would fail, which is why the paper's remark takes ℘ = 0. Their utility conditions hold for CRRA. The theorem gives a unique optimal policy among the continuous increasing policies whose marginal utility stays within a bounded distance of u′(m), and convergence to it by time iteration from any such policy. The last period's rule, c = m, is one, and time iteration from it gives the finite-horizon solutions, so these converge to the optimal policy. That is the non-degenerate limiting solution; this last step is deduced here. Their Example 2.2 computes s̄ = Þ̊_R in this setting, so with the RIC their Proposition 2.6 gives c(m) ≥ (1 − Þ̊_R) m. Neither the RIC nor the WRIC is needed. The conditions are sufficient: mst-2022-value-existence shows the discounted-return condition is not necessary without permanent shocks. Their necessity result for the discount condition, Proposition 2.1, assumes positive utility, which ϱ > 1 rules out."@en ;
    bsm:status "deduced" ;
    bsm:resultKind "theorem" ;
    bsm:within bsm:BSM_0000200 ;
    bsm:assumes bsm:BSM_0000087 ;
    bsm:assumes bsm:BSM_0000199 ;
    bsm:concludes bsm:BSM_0000093 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#remark-stochdiscmst> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#fvac> ;
    dcterms:source <https://arxiv.org/abs/1905.13045v3> .

bsm:BSM_0000203
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "a stationary distribution in the liquidity-constrained model"@en ;
    skos:notation "mst-stationary-distribution" ;
    skos:note "Ma, Stachurski and Toda's Theorem 3.1, under their Assumption 3.1: some s̄ < 1 satisfying their condition (19), with s̄ G_R < 1. In the normalized problem, (19) holds exactly for s̄ ≥ Þ̊_R, so it needs the RIC. G_R, the mean return, is ℛ E[ψ⁻¹], so Þ̊_R G_R = Þ̊_𝒢 E[ψ⁻¹]: Assumption 3.1 is the RIC together with the GIC-Mod. The GIC-Mod follows from the discounted-return condition (discounted-return-implies-gic-mod), so it is not listed. Their households do not die. With ℒ < 1 the population also replaces the dead, which their theorem does not cover. Its stationary distribution is of normalized market resources, each household weighted equally."@en ;
    bsm:status "deduced" ;
    bsm:resultKind "theorem" ;
    bsm:within bsm:BSM_0000200 ;
    bsm:assumes bsm:BSM_0000087 ;
    bsm:assumes bsm:BSM_0000199 ;
    bsm:assumes bsm:BSM_0000083 ;
    bsm:concludes bsm:BSM_0000100 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#gicmod> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#ric> ;
    dcterms:source <https://arxiv.org/abs/1905.13045v3> .

bsm:BSM_0000204
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the discounted-return condition implies strong growth impatience"@en ;
    skos:notation "discounted-return-implies-gic-mod" ;
    skos:note "Jensen's inequality, with ϱ > 1: E[(Þ̊_𝒢/ψ)^ϱ] ≥ (Þ̊_𝒢 E[ψ⁻¹])^ϱ. So existence in the liquidity-constrained model, by Ma, Stachurski and Toda's conditions, already brings growth impatience in its strong form."@en ;
    bsm:status "deduced" ;
    bsm:resultKind "remark" ;
    bsm:assumes bsm:BSM_0000199 ;
    bsm:concludes bsm:BSM_0000089 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#gicmod> ;
    dcterms:source <https://arxiv.org/abs/1905.13045v3> .

bsm:BSM_0000205
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "existence without a condition on the return, without permanent shocks"@en ;
    skos:notation "mst-2022-value-existence" ;
    skos:note "Ma, Stachurski and Toda (2022) solve the income fluctuation problem through a transformed value function, with a constant discount factor below one, utility bounded above, which ϱ > 1 gives, and a lower bound on the expected utility of income, inf E u(ξ) > −∞, which a positive lowest income gives. They need no condition on the return. Their Remark 4.1 contrasts this with the G_βR condition. The normalized problem has a constant discount factor only when ψ is degenerate at one. Then it is β̊ 𝒢^(1−ϱ), the FVAC is its condition, and the discounted-return condition is the GIC. So without permanent shocks an optimal policy exists, and the finite horizons' values converge to its value, whether or not the GIC holds. The paper does not show that the finite horizons' consumption functions converge, so the property is not concluded. With permanent shocks the discount factor β̊(𝒢ψ′)^(1−ϱ) is random. Their footnote 20 says the extension to random discounting is straightforward, but does not give it. The paper cites this work where it says βR < 1 is not necessary."@en ;
    bsm:status "deduced" ;
    bsm:resultKind "theorem" ;
    bsm:within bsm:BSM_0000200 ;
    bsm:assumes bsm:BSM_0000087 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#aic> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#cite-maunboundeddp> ;
    dcterms:source <https://arxiv.org/abs/2012.00219v2> .

bsm:BSM_0000230
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "the natural limit is reached only when ϱ < k"@en ;
    skos:notation "natural-limit-reached-only-below-k" ;
    skos:note "Without a point mass at the joint worst income, an agent who saves exactly a_Nat lands next period within x of the floor with probability of order x^k, k the number of shocks with densities at their floors (2 with a positive floor and both, 1 with one). The expected marginal value at a_Nat is finite exactly when ϱ < k, so the constraint binds near the floor only then; with ϱ > k the household saves a vanishing amount there. With the class's ϱ > 1 only k = 2 and 1 < ϱ < 2 reach the limit. A derivation of 2026-10-18, run for one density."@en ;
    bsm:status "deduced" ;
    bsm:resultKind "remark" ;
    bsm:within bsm:BSM_0000211 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> .

bsm:BSM_0000231
    a owl:NamedIndividual, bsm:Result ;
    rdfs:label "in the zero-infima scenario a ≥ 0 binds"@en ;
    skos:notation "zero-infima-constraint-binds" ;
    skos:note "At a = 0, next period's resources are ξ′ alone, and the Euler equation's right side is β̊R E[(𝒢ψ′)^(−ϱ) u′(c(ξ′))], finite under the class's E[θ^(−ϱ)] < ∞ and E[ψ^(−ϱ)] < ∞, given c(m) ≥ const · m near zero. Since u′(m) → ∞ as m ↓ 0, c = m on an interval [0, m*], at every ϱ, and the stationary population has a mass at a = 0: Ma, Stachurski and Toda's Lemma C.2, that the constraint binds in finite time with positive probability. Derived on 2026-11-01, with a second derivation; not run."@en ;
    bsm:status "deduced" ;
    bsm:resultKind "remark" ;
    bsm:within bsm:BSM_0000212 ;
    bsm:concludes bsm:BSM_0000182 ;
    dcterms:source <https://arxiv.org/abs/1905.13045v3> .

bsm:BSM_0000129
    a owl:NamedIndividual, bsm:Identity ;
    rdfs:label "the problem in levels and in ratios"@en ;
    skos:notation "levels-and-ratios" ;
    skos:definition "The problem in levels, in (𝐦, 𝐩), and the normalized problem, in m = 𝐦/𝐩, are one model: 𝐜(𝐦, 𝐩) = 𝐩 c(𝐦/𝐩) and 𝐯(𝐦, 𝐩) = 𝐩^(1−ϱ) v(𝐦/𝐩)."@en ;
    bsm:identityKind "equivalence" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsubsec-ratio> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-recoverlevels> .

bsm:BSM_0000130
    a owl:NamedIndividual, bsm:Identity ;
    rdfs:label "the limiting solution and the stationary fixed point"@en ;
    skos:notation "limit-and-fixed-point" ;
    skos:definition "A non-degenerate limiting solution, the limit of the finite-horizon solutions, is a fixed point of the stationary Bellman operator, and so the solution of the infinite-horizon problem. A trellis is finite and states no such limit; the stationarity is a condition a stage does not impose."@en ;
    bsm:identityKind "equivalence" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-theory> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-stationarybellman> .

bsm:BSM_0000131
    a owl:NamedIndividual, bsm:Identity ;
    rdfs:label "the decision problem depends on β and ℒ through β̊"@en ;
    skos:notation "decision-problem-through-beta-eff" ;
    skos:definition "Without an annuity, the household's problem, and so its rule, depends on β and ℒ only through β̊ = β ℒ; the population does not, since ℒ also sets the rate of death and replacement. Two members with the same β̊ and different ℒ have one rule and two populations. Where survival depends on the current Markov state s, the rule depends on them only through β ℒ(s), state by state. With Blanchard's annuity, ℒ also enters the return R/ℒ that the budget carries, and the identity fails."@en ;
    bsm:identityKind "equivalence" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-mortality> .

bsm:BSM_0000132
    a owl:NamedIndividual, bsm:Identity ;
    rdfs:label "an artificial constraint no tighter than the natural one"@en ;
    skos:notation "loose-artificial-constraint" ;
    skos:definition "A model with a_Art ≤ a_Nat is the model without an artificial constraint: the natural constraint is in force, and a looser one never binds."@en ;
    bsm:identityKind "reduction" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#pdv> ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsubsec-deatonislimit> .

bsm:BSM_0000133
    a owl:NamedIndividual, bsm:Identity ;
    rdfs:label "a benefit with no unemployment"@en ;
    skos:notation "unemployment-benefit-without-unemployment" ;
    skos:definition "With ℘ = 0, ξ_u never pays, and models differing only in ξ_u are one model."@en ;
    bsm:identityKind "reduction" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#eq-transhkdef> .

bsm:BSM_0000134
    a owl:NamedIndividual, bsm:Identity ;
    rdfs:label "two written laws of one shock"@en ;
    skos:notation "same-laws" ;
    skos:definition "Two written laws of a shock are the same law when the ontology of probability distributions' identity rule says so; two models differing only in the spelling of their laws are one model."@en ;
    bsm:identityKind "equivalence" .

bsm:BSM_0000135
    a owl:NamedIndividual, bsm:Identity ;
    rdfs:label "Blanchard's annuity leaves patience unchanged"@en ;
    skos:notation "blanchard-patience" ;
    skos:definition "With Blanchard's annuity, β̊ R/ℒ = β R, so the absolute patience factor is the one with infinite lives; only the quantities in which R enters apart from Þ change, the return patience factor becoming Þ/(R/ℒ)."@en ;
    bsm:identityKind "equivalence" ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#sec-mortality> .

bsm:BSM_0000224
    a owl:NamedIndividual, bsm:Family ;
    rdfs:label "the schemas' family bst-natural/1"@en ;
    skos:notation "bst-natural-1" ;
    skos:definition "The schemas' family for the natural scenario with a point mass: its stage file states BST's own model, with truncated lognormals and the zero-income event; a positive benefit with a discrete ψ has no stage file yet."@en ;
    bsm:schemaDocument "schemas/bst/natural/parameters.schema.json" ;
    bsm:repository "https://github.com/llorracc/wg1-buffer-stock" ;
    bsm:writes bsm:BSM_0000210 ;
    bsm:writes bsm:BSM_0000004 ;
    bsm:writes bsm:BSM_0000008 .

bsm:BSM_0000226
    a owl:NamedIndividual, bsm:Family ;
    rdfs:label "the schemas' family bst-artificial/1"@en ;
    skos:notation "bst-artificial-1" ;
    skos:definition "The schemas' family for the artificial scenario, with truncated lognormals and an artificial constraint strictly above the natural one; at a_Art = 0 its members are liquidity-constrained."@en ;
    bsm:schemaDocument "schemas/bst/artificial/parameters.schema.json" ;
    bsm:repository "https://github.com/llorracc/wg1-buffer-stock" ;
    bsm:writes bsm:BSM_0000007 ;
    bsm:writes bsm:BSM_0000200 ;
    bsm:writes bsm:BSM_0000004 ;
    bsm:writes bsm:BSM_0000006 ;
    bsm:writes bsm:BSM_0000008 .

bsm:BSM_0000141
    a owl:NamedIndividual, bsm:Divergence ;
    rdfs:label "hafiscal-xi-is-theta"@en ;
    skos:notation "hafiscal-xi-is-theta" ;
    skos:definition "The published HAFiscal paper writes ξ for the employed transitory shock, which is BST's θ; BST's ξ is transitory income with the unemployment event included."@en ;
    bsm:where "hafiscal-qe" ;
    bsm:divergenceKind "notation" ;
    bsm:concerns bsm:BSM_0000034 ;
    dcterms:source <https://github.com/llorracc/HAFiscal-QE/blob/1afdf80de4325e436a0c1c20895f754aefefd38c/Subfiles/Model.tex#L129> .

bsm:BSM_0000142
    a owl:NamedIndividual, bsm:Divergence ;
    rdfs:label "hafiscal-target-is-a-moment"@en ;
    skos:notation "hafiscal-target-is-a-moment" ;
    skos:definition "In the HAFiscal paper and code a \"target\" is mostly an estimation target, a data moment matched, not BST's target ratio of market resources."@en ;
    bsm:where "hafiscal-qe" ;
    bsm:divergenceKind "meaning" ;
    bsm:concerns bsm:BSM_0000097 ;
    dcterms:source <https://github.com/llorracc/HAFiscal-QE/blob/1afdf80de4325e436a0c1c20895f754aefefd38c/Subfiles/Parameterization.tex#L20-L23> .

bsm:BSM_0000143
    a owl:NamedIndividual, bsm:Divergence ;
    rdfs:label "hafiscal-mpc-is-a-lottery-mpc"@en ;
    skos:notation "hafiscal-mpc-is-a-lottery-mpc" ;
    skos:definition "HAFiscal's MPC is the share of a windfall spent over the following four quarters, not the derivative c′(m) whose limits this ontology names."@en ;
    bsm:where "hafiscal-qe" ;
    bsm:divergenceKind "meaning" ;
    bsm:concerns bsm:BSM_0000079 ;
    dcterms:source <https://github.com/llorracc/HAFiscal-QE/blob/1afdf80de4325e436a0c1c20895f754aefefd38c/Subfiles/Parameterization.tex#L20> .

bsm:BSM_0000178
    a owl:NamedIndividual, bsm:Divergence ;
    rdfs:label "bst-mean-and-the-forward-operator"@en ;
    skos:notation "bst-mean-and-the-forward-operator" ;
    skos:definition "BST writes 𝕄 for the cross-sectional mean, the pairing of the population's measure with a function; a stage's forward distribution operator is written 𝕄_π. One letter names two objects."@en ;
    bsm:where "bst" ;
    bsm:divergenceKind "notation" ;
    bsm:concerns bsm:BSM_0000056 ;
    dcterms:source <https://llorracc.github.io/BufferStockTheory/#subsec-cgroeqpermgrofacq> .
