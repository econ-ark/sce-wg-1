bsm:Model a owl:Class ;
    rdfs:label "model"@en ;
    skos:definition "A model: a member of a model class."@en .

bsm:ModelClass a owl:Class ;
    rdfs:label "model-class"@en ;
    skos:definition "A class of models, defined by axioms. A model is a member when it satisfies every membership axiom."@en .

bsm:Axiom a owl:Class ;
    rdfs:label "axiom"@en ;
    skos:definition "A statement a model must satisfy to be a member of a class (membership), or one a class's results assume (hypothesis)."@en .

bsm:Object a owl:Class ;
    rdfs:label "object"@en ;
    skos:definition "An economic or mathematical entity of the model, independent of any written form."@en .

bsm:Moment a owl:Class ;
    rdfs:label "moment"@en ;
    skos:definition "An expectation under the law of one shock, a quantity the conditions rest on."@en .

bsm:Quantity a owl:Class ;
    rdfs:label "quantity"@en ;
    skos:definition "A number the model's primitives determine, stated by a formula in the ontology's formula syntax."@en .

bsm:Condition a owl:Class ;
    rdfs:label "condition"@en ;
    skos:definition "An inequality on quantities, which holds or fails for a model."@en .

bsm:Property a owl:Class ;
    rdfs:label "property"@en ;
    skos:definition "A statement about a model's solution or population, which its conditions can guarantee."@en .

bsm:Result a owl:Class ;
    rdfs:label "result"@en ;
    skos:definition "A proposition relating conditions and properties, with the source that proves, cites or rules it."@en .

bsm:Identity a owl:Class ;
    rdfs:label "identity"@en ;
    skos:definition "A criterion for when two models, or two statements of one model, are the same."@en .

bsm:Family a owl:Class ;
    rdfs:label "family"@en ;
    skos:definition "A written family of the working group's schemas, and the class of models it writes."@en .

bsm:Divergence a owl:Class ;
    rdfs:label "divergence"@en ;
    skos:definition "A place where another paper, a notation or a schema uses a term of this ontology in another sense."@en .

bsm:Agent a owl:Class ;
    rdfs:subClassOf bsm:Object ;
    rdfs:label "agent"@en ;
    skos:definition "who chooses"@en .

bsm:Population a owl:Class ;
    rdfs:subClassOf bsm:Object ;
    rdfs:label "population"@en ;
    skos:definition "a collection of agents"@en .

bsm:Time a owl:Class ;
    rdfs:subClassOf bsm:Object ;
    rdfs:label "time"@en ;
    skos:definition "the clock"@en .

bsm:Structure a owl:Class ;
    rdfs:subClassOf bsm:Object ;
    rdfs:label "structure"@en ;
    skos:definition "a unit of the problem's composition, a stage or a trellis"@en .

bsm:Perch a owl:Class ;
    rdfs:subClassOf bsm:Object ;
    bsm:bellmanConcept "perch" ;
    rdfs:label "perch"@en ;
    skos:definition "one of a stage's three information contexts, arrival, decision and continuation; not a date"@en .

bsm:State a owl:Class ;
    rdfs:subClassOf bsm:Object ;
    bsm:bellmanConcept "field" ;
    rdfs:label "state"@en ;
    skos:definition "a field at a perch on which the remaining problem depends"@en .

bsm:Control a owl:Class ;
    rdfs:subClassOf bsm:Object ;
    bsm:bellmanConcept "field" ;
    rdfs:label "control"@en ;
    skos:definition "a field the agent chooses at the decision perch"@en .

bsm:Shock a owl:Class ;
    rdfs:subClassOf bsm:Object ;
    bsm:bellmanConcept "field" ;
    rdfs:label "shock"@en ;
    skos:definition "a field drawn by nature on a transition, with a declared law; a two-point outcome is a shock on a two-point set"@en .

bsm:Value a owl:Class ;
    rdfs:subClassOf bsm:Object ;
    bsm:bellmanConcept "field" ;
    rdfs:label "value"@en ;
    skos:definition "a value field at a perch, represented by a function of that perch's state"@en .

bsm:Primitive a owl:Class ;
    rdfs:subClassOf bsm:Object ;
    bsm:bellmanConcept "parameters" ;
    rdfs:label "primitive"@en ;
    skos:definition "a parameter, given to the model from outside; it defines the problem, as a setting never does"@en .

bsm:Bound a owl:Class ;
    rdfs:subClassOf bsm:Object ;
    rdfs:label "bound"@en ;
    skos:definition "a property of a shock's law, its infimum or the mass there, and no field or parameter"@en .

bsm:Function a owl:Class ;
    rdfs:subClassOf bsm:Object ;
    rdfs:label "function"@en ;
    skos:definition "a map the model defines or its solution yields, a policy or a derivative of a value among them"@en .

bsm:LawOfMotion a owl:Class ;
    rdfs:subClassOf bsm:Object ;
    rdfs:label "law-of-motion"@en ;
    skos:definition "a transition from one perch's state to the next, with the shocks drawn on it"@en .

bsm:Connector a owl:Class ;
    rdfs:subClassOf bsm:Object ;
    bsm:bellmanConcept "connector" ;
    rdfs:label "connector"@en ;
    skos:definition "the renaming that joins one period's continuation state to the next period's arrival state, with no calculation"@en .

bsm:Operator a owl:Class ;
    rdfs:subClassOf bsm:Object ;
    bsm:bellmanConcept "operator" ;
    rdfs:label "operator"@en ;
    skos:definition "a map between spaces of functions or of measures, as a stage operator is"@en .

bsm:Operation a owl:Class ;
    rdfs:subClassOf bsm:Object ;
    rdfs:label "operation"@en ;
    skos:definition "a constituent operation of an operator, such as an expectation or a pairing of a measure with a function"@en .

bsm:Relation a owl:Class ;
    rdfs:subClassOf bsm:Object ;
    rdfs:label "relation"@en ;
    skos:definition "an equation or inequality the solution satisfies, such as a first-order condition with its clause"@en .

bsm:Constraint a owl:Class ;
    rdfs:subClassOf bsm:Object ;
    rdfs:label "constraint"@en ;
    skos:definition "a restriction on the choice or the states"@en .

bsm:Measure a owl:Class ;
    rdfs:subClassOf bsm:Object ;
    rdfs:label "measure"@en ;
    skos:definition "a weighting of a population, a measure on a perch's states"@en .

bsm:axiomOf a owl:ObjectProperty ;
    skos:definition "The model class an axiom belongs to."@en .

