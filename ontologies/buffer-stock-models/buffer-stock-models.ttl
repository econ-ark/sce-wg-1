    skos:definition "The model class in which the limit a result describes lies."@en .

bsm:writes a owl:ObjectProperty ;
    skos:definition "A model class whose members a written family writes."@en .

bsm:concerns a owl:ObjectProperty ;
    skos:definition "The term a divergence concerns."@en .

bsm:lawIn a owl:ObjectProperty ;
    skos:definition "A family or constraint of the ontology of probability distributions that a shock's law belongs to."@en .

bsm:atPerch a owl:ObjectProperty ;
    skos:definition "The perch at which a field is known, or a function's state lies."@en .

bsm:functionOf a owl:ObjectProperty ;
    skos:definition "The state of which a value or a function is a function."@en .

bsm:lawProperty a owl:ObjectProperty ;
    skos:definition "The property of a law, in the ontology of probability distributions, that a bound is."@en .

bsm:formula a owl:DatatypeProperty ;
    skos:definition "A formula in the ontology's formula syntax."@en .

bsm:holdsWhen a owl:DatatypeProperty ;
